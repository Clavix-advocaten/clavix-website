---
const currentYear = new Date().getFullYear()
---

<footer class="bg-bg-inverse" style="color: var(--ns-50);">
  <div class="max-w-container mx-auto px-4 md:px-8 py-16">
    {/* Nieuwsbrief-aanmelding */}
    <div class="mb-12 pb-12" style="border-bottom: 1px solid var(--ns-700);">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
        <div>
          <h2 class="text-h3 font-bold mb-1" style="color: var(--neutral-0);">Maandelijks juridisch bij in vijf minuten</h2>
          <p class="text-small" style="color: var(--ns-200);">Wetgeving, uitspraken en tarieven die ondernemers met vastgoed raken. <a href="/nieuwsbrief/" class="underline" style="color: var(--neutral-0);">Meer over de nieuwsbrief</a></p>
        </div>
        <form name="nieuwsbrief" method="POST" action="/nieuwsbrief?aangemeld=true" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col sm:flex-row gap-3">
          <p class="hidden"><label>Niet invullen: <input name="bot-field" /></label></p>
          <input type="hidden" name="form-name" value="nieuwsbrief" />
          <label for="footer-nb-email" class="sr-only">E-mailadres</label>
          <input id="footer-nb-email" name="email" type="email" required placeholder="uw@email.nl" class="flex-1 p-3 rounded-md border border-border bg-bg text-text" />
          <button type="submit" class="bg-brand-primary text-white font-semibold px-6 py-3 rounded-md hover:opacity-90 transition cursor-pointer whitespace-nowrap">Aanmelden</button>
        </form>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10">
      {/* Kolom 1: Clavix branding */}
      <div>
        <img src="/clavix-logo-light.svg" alt="Clavix" class="h-9 w-auto mb-3" width="180" height="36" />
        <p class="text-small italic mb-4" style="color: var(--ns-300);">De sleutel tot uw oplossing.</p>
        <address class="text-small not-italic space-y-1" style="color: var(--ns-100);">
          <div>Strawinskylaan 257</div>
          <div>1077 XX Amsterdam</div>
          <div class="pt-2">
            <a href="tel:+31207471121" class="hover:underline" style="color: var(--neutral-0);">+31 20 747 1121</a>
          </div>
          <div>
            <a href="mailto:info@clavix.nl" class="hover:underline" style="color: var(--neutral-0);">info@clavix.nl</a>
          </div>
        </address>
        <div class="mt-4 flex gap-3">
          <a
            href="https://www.linkedin.com/company/106861158/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block transition-colors"
            style="color: var(--ns-200);"
            aria-label="Clavix op LinkedIn"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          
          <a
            href="https://www.instagram.com/clavix_nl/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block transition-colors"
            style="color: var(--ns-200);"
            aria-label="Clavix op Instagram"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          
          <a
            href="https://www.facebook.com/clavixnl/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block transition-colors"
            style="color: var(--ns-200);"
            aria-label="Clavix op Facebook"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
          </a>
        </div>
      </div>

      {/* Kolom 2: Praktijkgebieden */}
      <div>
        <h3 class="font-semibold mb-4 text-base" style="color: var(--neutral-0);">Praktijkgebieden</h3>
        <ul class="space-y-2 text-small">
          <li><a href="/praktijkgebieden/vastgoed-en-ondernemers/" class="no-underline hover:underline" style="color: var(--ns-100);">Vastgoed × Ondernemers</a></li>
          <li><a href="/praktijkgebieden/ondernemingsrecht/" class="no-underline hover:underline" style="color: var(--ns-100);">Ondernemingsrecht</a></li>
          <li><a href="/praktijkgebieden/vastgoedrecht/" class="no-underline hover:underline" style="color: var(--ns-100);">Vastgoedrecht</a></li>
          <li><a href="/praktijkgebieden/burgerlijk-procesrecht/" class="no-underline hover:underline" style="color: var(--ns-100);">Burgerlijk procesrecht</a></li>
          <li><a href="/praktijkgebieden/insolventie-en-herstructurering/" class="no-underline hover:underline" style="color: var(--ns-100);">Insolventie & herstructurering</a></li>
        </ul>
        <h3 class="font-semibold mb-4 mt-8 text-base" style="color: var(--neutral-0);">Sectoren</h3>
        <ul class="space-y-2 text-small">
          <li><a href="/sectoren/zorg/" class="no-underline hover:underline" style="color: var(--ns-100);">Zorg</a></li>
          <li><a href="/sectoren/tech/" class="no-underline hover:underline" style="color: var(--ns-100);">Tech & SaaS</a></li>
          <li><a href="/sectoren/horeca/" class="no-underline hover:underline" style="color: var(--ns-100);">Horeca</a></li>
          <li><a href="/sectoren/bouw/" class="no-underline hover:underline" style="color: var(--ns-100);">Bouw</a></li>
          <li><a href="/sectoren/retail/" class="no-underline hover:underline" style="color: var(--ns-100);">Retail</a></li>
          <li><a href="/sectoren/vastgoed-projecten/" class="no-underline hover:underline" style="color: var(--ns-100);">Vastgoed & Projecten</a></li>
        </ul>
      </div>

      {/* Kolom 3: Het kantoor */}
      <div>
        <h3 class="font-semibold mb-4 text-base" style="color: var(--neutral-0);">Het kantoor</h3>
        <ul class="space-y-2 text-small">
          <li><a href="/kumar/" class="no-underline hover:underline" style="color: var(--ns-100);">Over mr. Kumar</a></li>
          <li><a href="/werkwijze/" class="no-underline hover:underline" style="color: var(--ns-100);">Werkwijze en tarieven</a></li>
          <li><a href="/kosten/" class="no-underline hover:underline" style="color: var(--ns-100);">Wat kost een advocaat?</a></li>
          <li><a href="/advocaat-zuidas/" class="no-underline hover:underline" style="color: var(--ns-100);">Advocaat op de Zuidas</a></li>
          <li><a href="/kennisbank/" class="no-underline hover:underline" style="color: var(--ns-100);">Kennisbank</a></li>
          <li><a href="/veelgestelde-vragen/" class="no-underline hover:underline" style="color: var(--ns-100);">Veelgestelde vragen</a></li>
          <li><a href="/notities/" class="no-underline hover:underline" style="color: var(--ns-100);">Notities</a></li>
          <li><a href="/contact/" class="no-underline hover:underline" style="color: var(--ns-100);">Contact</a></li>
          <li><a href="/en/" class="no-underline hover:underline" style="color: var(--ns-100);" hreflang="en" lang="en">English</a></li>
        </ul>
      </div>

      {/* Kolom 4: Zelf regelen */}
      <div>
        <h3 class="font-semibold mb-4 text-base" style="color: var(--neutral-0);">Zelf regelen</h3>
        <ul class="space-y-2 text-small">
          <li><a href="/wettelijke-rente-berekenen/" class="no-underline hover:underline" style="color: var(--ns-100);">Wettelijke rente berekenen</a></li>
          <li><a href="/incassokosten-berekenen/" class="no-underline hover:underline" style="color: var(--ns-100);">Incassokosten berekenen</a></li>
          <li><a href="/proceskosten-berekenen/" class="no-underline hover:underline" style="color: var(--ns-100);">Proceskosten berekenen</a></li>
          <li><a href="/modelbrieven/" class="no-underline hover:underline" style="color: var(--ns-100);">Modelbrieven</a></li>
          <li><a href="/woordenlijst/" class="no-underline hover:underline" style="color: var(--ns-100);">Woordenlijst</a></li>
          <li><a href="/juridisch-abonnement/" class="no-underline hover:underline" style="color: var(--ns-100);">Juridisch abonnement</a></li>
        </ul>
      </div>

      {/* Kolom 5: Juridisch */}
      <div>
        <h3 class="font-semibold mb-4 text-base" style="color: var(--neutral-0);">Juridisch</h3>
        <ul class="space-y-2 text-small">
          <li><a href="/algemene-voorwaarden/" class="no-underline hover:underline" style="color: var(--ns-100);">Algemene voorwaarden</a></li>
          <li><a href="/disclaimer/" class="no-underline hover:underline" style="color: var(--ns-100);">Disclaimer</a></li>
          <li><a href="/klachtenregeling/" class="no-underline hover:underline" style="color: var(--ns-100);">Klachtenregeling</a></li>
          <li><a href="/privacy/" class="no-underline hover:underline" style="color: var(--ns-100);">Privacyverklaring</a></li>
          <li><a href="/cookies/" class="no-underline hover:underline" style="color: var(--ns-100);">Cookieverklaring</a></li>
          <li><a href="/toegankelijkheid/" class="no-underline hover:underline" style="color: var(--ns-100);">Toegankelijkheid</a></li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="border-t mt-12 pt-8 text-tiny flex flex-col md:flex-row justify-between gap-4" style="border-color: var(--rb-700); color: var(--ns-200);">
      <div>
        © 2025 - {currentYear} Clavix B.V. — KvK 96800747 — BTW NL867766839B01
      </div>
      <div>
        NOvA-geregistreerd ondernemingsrecht en burgerlijk procesrecht
      </div>
    </div>
  </div>
</footer>
