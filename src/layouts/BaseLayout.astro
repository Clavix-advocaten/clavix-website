---
import '@fontsource-variable/montserrat';
/**
 * Base layout — gebruikt op alle pagina's.
 * Bevat: HTML doctype, head met meta + Montserrat font + schema markup, base structure.
 */

import '@styles/tokens.css'
import Navigation from '@components/Navigation.astro'
import Footer from '@components/Footer.astro'
import { organizationSchema, siteNavigationSchema } from '@lib/schema-markup'

interface Props {
  title: string
  description?: string
  ogImage?: string
  canonical?: string
  noindex?: boolean
  schemaJsonLd?: object | object[] | null
}

const {
  title,
  description = 'Clavix Advocaten — boutique advocatenkantoor in Amsterdam Zuidas voor ondernemers met vastgoed.',
  ogImage = '/og-default.png',
  canonical,
  noindex = false,
  schemaJsonLd,
} = Astro.props

const siteUrl = 'https://clavix.nl' // Wordt later netlify-env-aware
const fullTitle = title.includes('Clavix') ? title : `${title} — Clavix Advocaten`
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`

// Bouw schema-array
const schemas = [organizationSchema()]
if (schemaJsonLd) {
  if (Array.isArray(schemaJsonLd)) schemas.push(...schemaJsonLd)
  else schemas.push(schemaJsonLd)
}
---

<!doctype html>
<html lang="nl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Clavix Advocaten" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />


    {/* Schema.org JSON-LD */}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(siteNavigationSchema())} />
      <!-- Google Ads conversietracking. Inert zolang id leeg is. -->
    <script is:inline>
      window.clavixAds = {
        id: '',
        contact: '',
        telefoon: '',
        mail: ''
      };
      (function () {
        if (!window.clavixAds.id) return;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.clavixAds.id;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', window.clavixAds.id);
      })();
      window.clavixConv = function (naam) {
        var label = window.clavixAds[naam];
        if (!label || !window.gtag) return;
        window.gtag('event', 'conversion', { send_to: label });
      };
    </script>

      <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-5d6wDb3LHYrroGyV8RKfM.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <script is:inline>
      document.addEventListener("click", function (e) {
        var t = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (t) { window.plausible && window.plausible("Telefoonklik"); window.clavixConv && window.clavixConv("telefoon"); return; }
        var m = e.target.closest && e.target.closest('a[href^="mailto:"]');
        if (m) { window.plausible && window.plausible("Mailklik"); window.clavixConv && window.clavixConv("mail"); }
      });
    </script>
  </head>
  <body class="bg-bg text-text font-body antialiased">
    <a href="#main" class="skip-link">Direct naar inhoud</a>
    <Navigation />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Tailwind + Astro houden alles correct, deze section voor extra global styles */
</style>
