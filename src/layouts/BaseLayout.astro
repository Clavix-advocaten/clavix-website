---
import '@fontsource-variable/montserrat';
import montserratLatinWoff2 from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
/**
 * Base layout — gebruikt op alle pagina's.
 * Bevat: HTML doctype, head met meta + Montserrat font + schema markup, base structure.
 */

import '@styles/tokens.css'
import Navigation from '@components/Navigation.astro'
import Footer from '@components/Footer.astro'
import NavigationEN from '@components/NavigationEN.astro'
import FooterEN from '@components/FooterEN.astro'
import { organizationSchema, siteNavigationSchema } from '@lib/schema-markup'

interface Props {
  title: string
  description?: string
  ogImage?: string
  ogType?: string
  publishedTime?: string
  modifiedTime?: string
  canonical?: string
  noindex?: boolean
  schemaJsonLd?: object | object[] | null
  lang?: string
  ogLocale?: string
  alternates?: { hreflang: string; href: string }[]
}

const {
  title,
  description = 'Clavix Advocaten — boutique advocatenkantoor in Amsterdam Zuidas voor ondernemers met vastgoed.',
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  canonical,
  noindex = false,
  schemaJsonLd,
  lang = 'nl',
  ogLocale = 'nl_NL',
  alternates = [],
} = Astro.props

const siteUrl = 'https://clavix.nl' // Wordt later netlify-env-aware
const fullTitle = title.includes('Clavix') ? title : `${title} — Clavix Advocaten`
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`

// Bouw schema-array
const schemas = [organizationSchema(lang === 'en' ? 'en' : 'nl')]
if (schemaJsonLd) {
  if (Array.isArray(schemaJsonLd)) schemas.push(...schemaJsonLd)
  else schemas.push(schemaJsonLd)
}

// Taalwisselaar op EN-pagina's: de Nederlandse tegenhanger uit de hreflang-paren
const nlAlternate = alternates.find((a) => a.hreflang === 'nl')?.href || '/'
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={montserratLatinWoff2} as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href.startsWith('http') ? a.href : `${siteUrl}${a.href}`} />
    ))}

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Clavix Advocaten" />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://clavix.nl/kumar/" />}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />


    {/* Schema.org JSON-LD */}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(siteNavigationSchema())} />
      <!-- Google Ads click-id opvang. Geen cookies, sessiegebonden. -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        var KEYS = ['gclid', 'wbraid', 'gbraid'];
        var params = new URLSearchParams(window.location.search);

        // Vang de click-id op zodra iemand vanuit een advertentie binnenkomt
        for (var i = 0; i < KEYS.length; i++) {
          var v = params.get(KEYS[i]);
          if (v) {
            try {
              sessionStorage.setItem('clavix_click_id', KEYS[i] + ':' + v);
              sessionStorage.setItem('clavix_click_ts', new Date().toISOString());
            } catch (e) {}
            break;
          }
        }

        // Vul verborgen formuliervelden zodra de pagina geladen is
        function vul() {
          var id = '', ts = '';
          try {
            id = sessionStorage.getItem('clavix_click_id') || '';
            ts = sessionStorage.getItem('clavix_click_ts') || '';
          } catch (e) { return; }
          if (!id) return;
          var a = document.querySelectorAll('input[name="click_id"]');
          for (var i = 0; i < a.length; i++) a[i].value = id;
          var b = document.querySelectorAll('input[name="click_ts"]');
          for (var j = 0; j < b.length; j++) b[j].value = ts;
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', vul);
        } else {
          vul();
        }
      })();
    </script>

      <!-- Privacy-friendly analytics by Plausible (geproxyd via /stats/) -->
    <script async src="/stats/js/pa-5d6wDb3LHYrroGyV8RKfM.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <script is:inline>
      document.addEventListener("click", function (e) {
        var t = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (t) { window.plausible && window.plausible("Telefoonklik"); return; }
        var m = e.target.closest && e.target.closest('a[href^="mailto:"]');
        if (m) { window.plausible && window.plausible("Mailklik"); }
      });
    </script>
  </head>
  <body class="bg-bg text-text font-body antialiased">
    <a href="#main" class="skip-link">{lang === 'en' ? 'Skip to content' : 'Direct naar inhoud'}</a>
    {lang === 'en' ? <NavigationEN nlHref={nlAlternate} /> : <Navigation />}
    <main id="main">
      <slot />
    </main>
    {lang === 'en' ? <FooterEN /> : <Footer />}
  </body>
</html>

<style is:global>
  /* Tailwind + Astro houden alles correct, deze section voor extra global styles */
</style>
