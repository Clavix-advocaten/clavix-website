---
import '@fontsource-variable/montserrat';
import montserratLatinWoff2 from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
/**
 * Base layout — gebruikt op alle pagina's.
 * Bevat: HTML doctype, head met meta + Montserrat font + schema markup, base structure.
 */

import '@styles/tokens.css'
import Navigation from '@components/Navigation.astro'
import Footer from '@components/Footer.astro'
import NavigationEN from '@components/NavigationEN.astro'
import FooterEN from '@components/FooterEN.astro'
import { organizationSchema, siteNavigationSchema, websiteSchema } from '@lib/schema-markup'

interface Props {
  title: string
  description?: string
  ogImage?: string
  ogType?: string
  publishedTime?: string
  modifiedTime?: string
  canonical?: string
  noindex?: boolean
  schemaJsonLd?: object | object[] | null
  lang?: string
  ogLocale?: string
  alternates?: { hreflang: string; href: string }[]
}

const {
  title,
  description = 'Clavix, boutique advocatenkantoor in Amsterdam Zuidas voor ondernemers met vastgoed.',
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  canonical,
  noindex = false,
  schemaJsonLd,
  lang = 'nl',
  ogLocale = 'nl_NL',
  alternates = [],
} = Astro.props

const siteUrl = 'https://clavix.nl' // Wordt later netlify-env-aware
// Merk-suffix alleen zolang de titel binnen 60 tekens blijft (SERP-afkapgrens)
const fullTitle = title.includes('Clavix')
  ? title
  : title.length <= 51
    ? `${title} | Clavix`
    : title
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`

// Bouw schema-array
const schemas = [websiteSchema(), organizationSchema(lang === 'en' ? 'en' : 'nl')]
if (schemaJsonLd) {
  if (Array.isArray(schemaJsonLd)) schemas.push(...schemaJsonLd)
  else schemas.push(schemaJsonLd)
}

// Taalwisselaar op EN-pagina's: de Nederlandse tegenhanger uit de hreflang-paren
const nlAlternate = alternates.find((a) => a.hreflang === 'nl')?.href || '/'
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={montserratLatinWoff2} as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href.startsWith('http') ? a.href : `${siteUrl}${a.href}`} />
    ))}

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Clavix" />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://clavix.nl/kumar/" />}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />


    {/* Schema.org JSON-LD */}
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(siteNavigationSchema())} />
      <!-- Google Ads click-id, de landingspagina en de utm-velden opvangen. Geen cookies, sessiegebonden; ze gaan
           alleen mee als iemand zelf een formulier verstuurt, zodat de herkomst van de aanvraag klopt. -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;
        var KEYS = ['gclid', 'wbraid', 'gbraid'];
        var params = new URLSearchParams(window.location.search);

        // Vang de click-id op zodra iemand vanuit een advertentie binnenkomt
        for (var i = 0; i < KEYS.length; i++) {
          var v = params.get(KEYS[i]);
          if (v) {
            try {
              sessionStorage.setItem('clavix_click_id', KEYS[i] + ':' + v);
              sessionStorage.setItem('clavix_click_ts', new Date().toISOString());
            } catch (e) {}
            break;
          }
        }

        // De eerste pagina van het bezoek is de landingspagina; de utm-velden komen van de advertentie of link.
        try {
          if (!sessionStorage.getItem('clavix_landing')) {
            sessionStorage.setItem('clavix_landing', window.location.pathname.toLowerCase());
          }
          var utm = ['utm_source', 'utm_medium', 'utm_campaign']
            .map(function (k) { return (params.get(k) || '').slice(0, 80); });
          if (utm.join('') && !sessionStorage.getItem('clavix_utm')) {
            sessionStorage.setItem('clavix_utm', utm.join(' / '));
          }
        } catch (e) {}

        function zet(naam, waarde) {
          if (!waarde) return;
          var a = document.querySelectorAll('input[name="' + naam + '"]');
          for (var i = 0; i < a.length; i++) a[i].value = waarde;
        }

        // Vul verborgen formuliervelden zodra de pagina geladen is
        function vul() {
          try {
            zet('click_id', sessionStorage.getItem('clavix_click_id') || '');
            zet('click_ts', sessionStorage.getItem('clavix_click_ts') || '');
            zet('landingspagina', sessionStorage.getItem('clavix_landing') || '');
            zet('utm', sessionStorage.getItem('clavix_utm') || '');
          } catch (e) {}
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', vul);
        } else {
          vul();
        }
      })();
    </script>

      <!-- Privacy-friendly analytics by Plausible (geproxyd via /stats/) -->
    <script async src="/stats/js/pa-5d6wDb3LHYrroGyV8RKfM.js"></script>
    {/* is:inline is nodig: zonder maakt Astro hier een module van, en een module draait
        pas na het parsen van de pagina. De bevestiging op de bedankpagina's (Contact
        verzonden, Nieuwsbrief, Modelbrief, Abonnement) draait eerder, zag nog geen
        window.plausible en meldde niets: die vier doelen stonden sinds juni op nul. */}
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({ endpoint: 'https://clavix.nl/stats/api/event' })
    </script>

    <script is:inline>
      document.addEventListener("click", function (e) {
        var t = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (t) { window.plausible && window.plausible("Telefoonklik"); return; }
        var m = e.target.closest && e.target.closest('a[href^="mailto:"]');
        if (m) { window.plausible && window.plausible("Mailklik"); }
      });
    </script>
  </head>
  <body class="bg-bg text-text font-body antialiased">
    <a href="#main" class="skip-link">{lang === 'en' ? 'Skip to content' : 'Direct naar inhoud'}</a>
    {lang === 'en' ? <NavigationEN nlHref={nlAlternate} /> : <Navigation />}
    <main id="main">
      <slot />
    </main>
    {lang === 'en' ? <FooterEN /> : <Footer />}
  </body>
</html>

<style is:global>
  /* Tailwind + Astro houden alles correct, deze section voor extra global styles */
</style>
