---
import BaseLayout from '@layouts/BaseLayout.astro'
import CTABand from '@components/CTABand.astro'
import AnswerCapsule from '@components/AnswerCapsule.astro'
import TLDR from '@components/TLDR.astro'
import FAQAccordion from '@components/FAQAccordion.astro'
import Breadcrumbs from '@components/Breadcrumbs.astro'
import { getClusterPage, getAllClusterSlugs } from '@lib/queries'
import { renderPortableText } from '@lib/portable-text'
import { articleSchema, faqPageSchema, breadcrumbSchema } from '@lib/schema-markup'

export async function getStaticPaths() {
  const slugs = await getAllClusterSlugs().catch(() => [])
  return slugs.map((s: any) => ({ params: { slug: s.slug } }))
}

const { slug } = Astro.params
const cluster = await getClusterPage(slug as string)

if (!cluster) return Astro.redirect('/404')

const breadcrumbs = [
  { name: 'Home', url: '/' },
]
if (cluster.parentPillar) {
  breadcrumbs.push({ name: cluster.parentPillar.shortTitle, url: `/praktijkgebieden/${cluster.parentPillar.slug}/` })
}
breadcrumbs.push({ name: cluster.title, url: `/clusters/${slug}/` })

const schemas: any[] = [
  articleSchema(cluster, cluster.author?.name || 'mr. Mukesh Kumar', `/clusters/${slug}/`),
  breadcrumbSchema(breadcrumbs),
]

if (cluster.faqs && cluster.faqs.length > 0) {
  const fp = faqPageSchema(cluster.faqs)
  if (fp) schemas.push(fp)
}

// === HowTo schema voor procedurele clusters ===
const HOWTO_STEPS: Record<string, string[]> = {
  '50-50-aandeelhoudersgeschil-oplossen': [
    'Beoordeel of mediation een werkbare uitweg biedt',
    'Onderzoek de shotgun-clausule in de aandeelhoudersovereenkomst',
    'Overweeg een geschillenregeling-procedure (2:336a en 2:343 BW)',
    'Bereid in laatste instantie een uitkoopprocedure voor',
  ],
  'activatransactie-faillissement': [
    'Verken haalbaarheid van een doorstart met het management',
    'Stel een onderhandelingsmemo op voor de curator',
    'Onderhandel over koopprijs, activa en personeel-overname',
    'Houd rekening met het Smallsteps-arrest bij personele overgang',
    'Sluit de notariele activatransactie-overeenkomst',
  ],
  'beslag-op-aandelen': [
    'Toets of er een gegrond vorderingsrecht aanwezig is',
    'Vraag verlof bij de voorzieningenrechter (artikel 700 Rv)',
    'Laat beslag formeel betekenen aan vennootschap en aandeelhouder',
    'Procedeer over de hoofdvordering ter validatie',
  ],
  'pre-pack-doorstart': [
    'Beoordeel financiele positie en doorstart-kansen',
    'Identificeer een serieuze overnemende partij',
    'Dien beoogd-curator-verzoek in bij de rechtbank',
    'Onderhandel concept-activatransactie in vertrouwen',
    'Vraag formeel faillissement aan',
    'Sluit de doorstart binnen 24-48 uur',
  ],
  'statuten-bv-wijzigen': [
    'Bepaal welke wijzigingen u wilt doorvoeren',
    'Roep een algemene vergadering van aandeelhouders bijeen',
    'Neem het wijzigingsbesluit met vereiste meerderheid',
    'Laat een notaris de akte van statutenwijziging opmaken',
    'Schrijf de gewijzigde statuten in bij de KvK',
  ],
  'verzet-tegen-faillissement': [
    'Beoordeel binnen 14 dagen of verzet kansrijk is',
    'Stel verzetschrift op bij de rechtbank',
    'Bereid verweer voor: pluraliteit, opeisbaarheid, betalingsonmacht',
    'Voer behandeling ter zitting',
    'Vraag vernietiging van het faillissementsvonnis',
  ],
  'whoa-traject-ondernemer-kosten-kansen': [
    'Verken financiele haalbaarheid van een WHOA-akkoord',
    'Stel het herstructureringsplan op met klassen-indeling',
    'Vraag afkoelingsperiode aan bij de rechtbank',
    'Bied het akkoord aan crediteurenklassen aan',
    'Vraag homologatie aan bij de rechtbank',
  ],
}

const clusterSlug = cluster.slug?.current || cluster.slug
const howToStepsForCluster = clusterSlug ? HOWTO_STEPS[clusterSlug] : undefined
if (howToStepsForCluster) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: cluster.title,
    description: cluster.seo?.metaDescription || cluster.subtitle || '',
    step: howToStepsForCluster.map((text, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: text,
    })),
  })
}


const seoTitle = cluster.seo?.metaTitle || cluster.title
const seoDescription = cluster.seo?.metaDescription || cluster.tldr?.body?.slice(0, 160) || cluster.subtitle

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })

// Contextuele CTA per rechtsgebied in plaats van een generieke band
const ctaPerPillar: Record<string, { heading: string; description: string }> = {
  'ondernemingsrecht': {
    heading: 'Een vennootschapsrechtelijke kwestie bespreken?',
    description: 'Van aandeelhoudersgeschil tot bestuurdersaansprakelijkheid: in een kosteloos eerste gesprek hoort u waar u staat en wat de logische volgende stap is.',
  },
  'vastgoedrecht': {
    heading: 'Een huur- of vastgoedkwestie bespreken?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u waar u staat en wat de logische volgende stap is.',
  },
  'insolventie-en-herstructurering': {
    heading: 'Staat u onder druk, of betaalt uw debiteur niet meer?',
    description: 'Hoe eerder u belt, hoe meer opties er zijn. In een kosteloos eerste gesprek hoort u welke routes nog openstaan.',
  },
  'burgerlijk-procesrecht': {
    heading: 'Een procedure starten of u verweren?',
    description: 'Wij beoordelen uw processpositie eerlijk: ook wanneer schikken verstandiger is dan procederen. Het eerste gesprek is kosteloos.',
  },
  'vastgoed-en-ondernemers': {
    heading: 'Uw bedrijf en uw vastgoed in één hand?',
    description: 'Precies op het snijvlak van ondernemingsrecht en vastgoed ligt onze praktijk. Het eerste gesprek is kosteloos.',
  },
}
// Slot dat bij de lezer van dit artikel past; valt terug op het rechtsgebied
const ctaPerSlug: Record<string, { heading: string; description: string }> = {
  'aandeelhoudersovereenkomst-minimaal': {
    heading: 'Een aandeelhoudersovereenkomst laten opstellen of nalopen?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u welke bepalingen uw situatie vraagt.',
  },
  'aanmaning': {
    heading: 'Een onbetaalde factuur bespreken?',
    description: 'Factuur open en de termijn verstreken? In een kosteloos eerste gesprek hoort u wat uw vordering nu oplevert en of beslag meer haalt dan dagvaarden.',
  },
  'aannemer-failliet-tijdens-bouw': {
    heading: 'Ligt uw bouwplaats stil?',
    description: 'In een kosteloos eerste gesprek hoort u of de brief aan de curator al uit kan en wat uw garanties waard zijn.',
  },
  'aansprakelijkheid-makelaar': {
    heading: 'Denkt u dat uw makelaar een fout heeft gemaakt?',
    description: 'In een kosteloos eerste gesprek hoort u welke route bij u past en welke termijn u in de gaten moet houden.',
  },
  'aansprakelijkheid-zakelijk': {
    heading: 'Aansprakelijk gesteld of schade geleden?',
    description: 'In een kosteloos gesprek van 30 minuten bekijken wij op welke grondslag de claim rust en waar uw sterkste verweer zit.',
  },
  'activatransactie-faillissement': {
    heading: 'Wilt u bieden op activa uit een faillissement?',
    description: 'In een kosteloos gesprek van 30 minuten bespreken wij uw bod en wat u vóór het bieden moet laten onderzoeken.',
  },
  'as-is-where-is-clausule': {
    heading: 'Staat as is where is in uw koopcontract?',
    description: 'In een kosteloos gesprek van 30 minuten hoort u wat de clausule in uw geval dekt en welke garanties u ernaast kunt zetten.',
  },
  'bedrijfsopvolging': {
    heading: 'Uw bedrijf overdragen aan uw kind of uw management?',
    description: 'In een kosteloos gesprek van 30 minuten bekijken wij welke stap u dit jaar al kunt zetten en wat daarvoor in de statuten moet staan.',
  },
  'exoneratiebeding-zakelijke-contracten': {
    heading: 'Een exoneratie of boetebeding laten toetsen?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u of het beding standhoudt en wat de volgende stap is.',
  },
  'faillissement-aanvragen-schuldeiser': {
    heading: 'Uw debiteur betaalt niet, maar handelt wel door?',
    description: 'In een kosteloos eerste gesprek hoort u of een faillissementsaanvraag in uw geval druk zet.',
  },
  'financieringsvoorbehoud': {
    heading: 'Een beroep op het financieringsvoorbehoud betwisten of onderbouwen?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u waar u staat.',
  },
  'franchise-geschillen': {
    heading: 'Een franchisegeschil?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u welke bedingen in uw contract nog standhouden.',
  },
  'geheimhoudingsverklaring-nda': {
    heading: 'Een NDA laten opstellen of een schending aanpakken?',
    description: 'In een kosteloos eerste gesprek van 30 minuten hoort u welke stap nu telt.',
  },
  'koop-breekt-geen-huur': {
    heading: 'Koopt u een verhuurd pand?',
    description: 'Of wilt u leeg leveren terwijl er nog een huurder zit? In een kosteloos eerste gesprek hoort u wat er meegaat en wat niet.',
  },
  'koopovereenkomst-ontbinden': {
    heading: 'Wilt u van een koop af, of ontbond uw wederpartij te vroeg?',
    description: 'In een kosteloos eerste gesprek hoort u of de ontbinding standhoudt.',
  },
  'kort-geding': {
    heading: 'Spoed in een geschil?',
    description: 'Gedagvaard in kort geding, of zelf een spoedvoorziening nodig? Het eerste gesprek van 30 minuten is kosteloos.',
  },
  'kwalitatieve-verplichting': {
    heading: 'Een beding in uw akte dat u niet wilt?',
    description: 'Of wilt u er een vestigen dat standhoudt? In een kosteloos eerste gesprek hoort u welke route past.',
  },
  'letter-of-intent': {
    heading: 'Ligt er een LOI op tafel, of is de wederpartij afgehaakt?',
    description: 'In een kosteloos eerste gesprek hoort u wat bindt en wat niet.',
  },
  'ontruiming-bedrijfsruimte': {
    heading: 'Betaalt uw huurder niet meer?',
    description: 'Hoe eerder de procedure start, hoe kleiner het gat. Het eerste gesprek van 30 minuten is kosteloos.',
  },
  'opzegging-huurovereenkomst-bedrijfsruimte': {
    heading: 'Wilt u een huurder van bedrijfsruimte opzeggen?',
    description: 'Laat de brief eerst lezen: een nietige opzegging is niet te repareren. Het eerste gesprek van 30 minuten is kosteloos.',
  },
  'rangorde-schuldeisers-faillissement': {
    heading: 'Is uw afnemer failliet?',
    description: 'In een kosteloos eerste gesprek hoort u of uw eigendomsvoorbehoud nog iets waard is en wat u meteen bij de curator meldt.',
  },
  'rechtsverwerking': {
    heading: 'Wordt u na jaren alsnog aangesproken?',
    description: 'Of dreigt u zelf een recht te verspelen? In een kosteloos eerste gesprek hoort u of het verweer kans maakt.',
  },
  'retentierecht-bouw': {
    heading: 'Zit uw bouwplaats op slot?',
    description: 'Of wilt u er zelf een op slot zetten? In een kosteloos eerste gesprek hoort u of het retentierecht standhoudt.',
  },
}
const ctaContext = ctaPerSlug[slug as string] || (cluster.parentPillar ? ctaPerPillar[cluster.parentPillar.slug] : undefined)

// De specialismepagina die bij dit onderwerp hoort.
//
// WAAROM DIT BESTAAT. De 87 kennisbankartikelen linkten alle naar hun pijler,
// maar géén enkele naar een specialismepagina: die kregen hun links alleen van
// de homepage, de pijlers en van elkaar. Dat zijn wel de pagina's met
// commerciële intentie ("advocaat aandeelhoudersgeschillen"), en samen haalden
// ze in 28 dagen 1.606 vertoningen met één klik, op posities 17 tot 78. De
// artikelen die het verkeer binnenhalen wijzen er nu naartoe, met de zoekterm
// van die pagina als anker.
//
// Niet elk artikel krijgt er een: de huur- en vastgoedartikelen hebben geen
// eigen specialismepagina (hun commerciële tegenhanger is de pijler
// vastgoedrecht), en bij leerstukken als causaal verband of rechtsverwerking
// past geen enkele.
const specialismen = {
  aandeelhouders: { href: '/specialisme/aandeelhoudersgeschillen/', anker: 'Advocaat aandeelhoudersgeschillen' },
  bestuurder: { href: '/specialisme/bestuurdersaansprakelijkheid/', anker: 'Advocaat bestuurdersaansprakelijkheid' },
  bouwrecht: { href: '/specialisme/bouwgeschillen/', anker: 'Advocaat bouwrecht in Amsterdam' },
  contracten: { href: '/specialisme/contractgeschillen/', anker: 'Advocaat contractenrecht in Amsterdam' },
  incasso: { href: '/specialisme/incasso-en-executie/', anker: 'Advocaat incasso en executierecht' },
  kortGeding: { href: '/specialisme/kort-geding/', anker: 'Advocaat kort geding in Amsterdam' },
  overdracht: { href: '/specialisme/bedrijfsoverdracht-met-vastgoed/', anker: 'Bedrijfsoverdracht met vastgoed' },
}
const specialismePerSlug: Record<string, keyof typeof specialismen> = {
  '50-50-aandeelhoudersgeschil-oplossen': 'aandeelhouders',
  'aandeelhoudersovereenkomst-minimaal': 'aandeelhouders',
  'aandeelhoudersgeschil-bedrijfspand': 'aandeelhouders',
  'concurrentiebeding-ex-aandeelhouders': 'aandeelhouders',
  'ondernemingskamer-procedure': 'aandeelhouders',
  'joint-venture': 'aandeelhouders',
  'statuten-bv-wijzigen': 'aandeelhouders',
  'ontslag-statutair-bestuurder': 'aandeelhouders',
  'bestuurdersaansprakelijkheid': 'bestuurder',
  'bestuurdersaansprakelijkheid-faillissement': 'bestuurder',
  'decharge-bestuurder': 'bestuurder',
  'turboliquidatie-bv': 'bestuurder',
  'pauliana-actie-curator': 'bestuurder',
  'paulianeus-handelen': 'bestuurder',
  'hoofdelijke-aansprakelijkheid-borgtocht': 'bestuurder',
  'bouwgeschil-aannemer-wanprestatie': 'bouwrecht',
  'aannemer-failliet-tijdens-bouw': 'bouwrecht',
  'retentierecht-bouw': 'bouwrecht',
  'dwaling': 'contracten',
  'exoneratiebeding-zakelijke-contracten': 'contracten',
  'koopovereenkomst-ontbinden': 'contracten',
  'geheimhoudingsverklaring-nda': 'contracten',
  'franchise-geschillen': 'contracten',
  'managementovereenkomst': 'contracten',
  'aansprakelijkheid-zakelijk': 'contracten',
  'financieringsvoorbehoud': 'contracten',
  'as-is-where-is-clausule': 'contracten',
  'ouderdomsclausule': 'contracten',
  'recht-van-eerste-koop': 'contracten',
  'aanmaning': 'incasso',
  'ingebrekestelling': 'incasso',
  'factuur-niet-betaald': 'incasso',
  'incassobureau-of-incasso-advocaat': 'incasso',
  'wettelijke-betalingstermijn': 'incasso',
  'deurwaarder-inschakelen': 'incasso',
  'conservatoir-beslag': 'incasso',
  'executoriaal-beslag': 'incasso',
  'beslag-op-bankrekening': 'incasso',
  'beslag-op-aandelen': 'incasso',
  'beslag-op-onroerend-goed': 'incasso',
  'beslag-opheffen': 'incasso',
  'faillissement-aanvragen-schuldeiser': 'incasso',
  'vordering-indienen-curator': 'incasso',
  'eigendomsvoorbehoud': 'incasso',
  'verrekening': 'incasso',
  'verjaring-stuiting': 'incasso',
  'kort-geding': 'kortGeding',
  'dwangsom': 'kortGeding',
  'smaad-laster-rectificatie': 'kortGeding',
  'ontruiming-bedrijfsruimte': 'kortGeding',
  'illegale-onderverhuur-aanpakken': 'kortGeding',
  'familiebedrijf-vastgoed-opvolging': 'overdracht',
  'verkoop-bedrijfspand-mna': 'overdracht',
  'letter-of-intent': 'overdracht',
  'bedrijfsopvolging': 'overdracht',
}
const specialisme = specialismen[specialismePerSlug[slug as string]]

// Halverwege het artikel een korte inline-CTA tonen
const midIndex = cluster.sections?.length >= 4 ? Math.floor(cluster.sections.length / 2) : -1

// Engelse tegenhangers in de /en/knowledge/-laag
const enCounterparts: Record<string, string> = {
  'bedrijfsruimte-290-of-230a-bw': '/en/knowledge/commercial-lease-regimes/',
  'huurprijswijziging-7-303-roz': '/en/knowledge/rent-review-dutch-law/',
  'verborgen-gebreken-bedrijfspand': '/en/knowledge/hidden-defects-commercial-property/',
  'huurachterstand-bedrijfsruimte-ontbinding': '/en/knowledge/rent-arrears-eviction-netherlands/',
  'erfpacht-amsterdam-herziening': '/en/knowledge/amsterdam-leasehold-erfpacht/',
}
const enHref = enCounterparts[slug as string]
const alternates = enHref
  ? [
      { hreflang: 'nl', href: `/clusters/${slug}/` },
      { hreflang: 'en', href: enHref },
      { hreflang: 'x-default', href: `/clusters/${slug}/` },
    ]
  : []
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  schemaJsonLd={schemas}
  ogImage={`/og/clusters-${slug}.png`}
  ogType="article"
  publishedTime={cluster.publishedAt}
  modifiedTime={cluster.modifiedAt || cluster.publishedAt}
  alternates={alternates}
>
  <article>
    <section class="bg-bg-tinted">
      <div class="max-w-content mx-auto px-4 md:px-8 py-12 md:py-16">
        <Breadcrumbs items={breadcrumbs.map((b, i) => (
          i === breadcrumbs.length - 1 ? { label: b.name } : { label: b.name, href: b.url }
        ))} />
        <h1 class="text-display font-extrabold text-text mb-3 tracking-tight">
          {cluster.title}
        </h1>
        {cluster.subtitle && (
          <p class="text-h3 text-text-secondary font-display font-semibold mb-6 italic">
            {cluster.subtitle}
          </p>
        )}
        <div class="text-tiny text-text-muted">
          {cluster.modifiedAt && <>Laatst bijgewerkt: {formatDate(cluster.modifiedAt)}</>}
          {cluster.author?.name && <> · Geschreven en juridisch gecontroleerd door <a href="/kumar/" class="text-text-muted underline hover:text-text-accent">{cluster.author.name}</a>, advocaat</>}
        </div>
      </div>
    </section>

    <div class="max-w-content mx-auto px-4 md:px-8 py-12">
      {cluster.tldr?.body && <TLDR heading={cluster.tldr.heading} body={cluster.tldr.body} />}

      {cluster.sections && cluster.sections.map((section: any, i: number) => (
        <>
          <section id={section.anchor} class="mt-16 scroll-mt-24">
            <h2 class="text-h2 font-bold mb-4 text-text">{section.heading}</h2>
            {section.answerCapsule && <AnswerCapsule text={section.answerCapsule} />}
            {section.body && (
              <div class="prose-content space-y-4 text-body text-text mt-6" set:html={renderPortableText(section.body)} />
            )}
          </section>
          {i === midIndex && (
            <aside class="mt-12 p-6 bg-bg-tinted border-l-4 border-brand-primary rounded-r-lg">
              <p class="text-body text-text mb-3"><strong>Speelt dit bij u?</strong> Een eerste gesprek van 30 minuten is kosteloos. U weet daarna waar u staat.</p>
              <a href="/contact/" class="inline-block bg-action text-action-fg hover:bg-action-hover px-5 py-2.5 rounded-md font-semibold text-small no-underline transition">Plan een eerste gesprek</a>
            </aside>
          )}
        </>
      ))}

      {cluster.faqs && cluster.faqs.length > 0 && <FAQAccordion faqs={cluster.faqs} />}

      {(cluster.parentPillar || specialisme) && (
        <section class="mt-20 p-6 bg-bg-tinted rounded-lg">
          <h3 class="text-h4 font-semibold text-text mb-3">Verder op deze site</h3>
          {cluster.parentPillar && (
            <p class="text-body mb-1">
              <span class="text-text-secondary">Het bredere onderwerp: </span>
              <a href={`/praktijkgebieden/${cluster.parentPillar.slug}/`} class="text-text-accent font-semibold no-underline hover:underline">
                {(cluster.parentPillar.seoTitle || cluster.parentPillar.shortTitle).replace(/\s*\|\s*Clavix.*$/, '')} →
              </a>
            </p>
          )}
          {specialisme && (
            <p class="text-body">
              <span class="text-text-secondary">Speelt dit nu in uw onderneming? </span>
              <a href={specialisme.href} class="text-text-accent font-semibold no-underline hover:underline">
                {specialisme.anker} →
              </a>
            </p>
          )}
        </section>
      )}

      {/* Auteursblok */}
      <div class="mt-16 pt-8 border-t border-border flex items-start gap-4">
        <img src="/portrait-128.webp" alt="Portretfoto van mr. Mukesh Kumar" width="64" height="64" loading="lazy" decoding="async" class="w-16 h-16 rounded-full object-cover flex-shrink-0" />
        <div>
          <div class="font-semibold text-text">{cluster.author?.name || 'mr. Mukesh Kumar'}</div>
          <p class="text-small text-text-secondary mt-1 max-w-readable">Advocaat ondernemingsrecht en vastgoed in Amsterdam Zuidas. Schrijft deze kennisbank voor ondernemers die eerst zelf willen begrijpen waar ze staan.</p>
          <p class="text-small mt-2">
            <a href="/kumar/" class="font-semibold text-text-accent no-underline hover:underline">Over mr. Kumar</a>
            <span class="text-text-muted"> · </span>
            <a href="/contact/" class="font-semibold text-text-accent no-underline hover:underline">Plan een kosteloos eerste gesprek</a>
          </p>
        </div>
      </div>
    </div>


      {cluster.relatedClusters && cluster.relatedClusters.length > 0 && (
        <section class="max-w-content mx-auto px-4 md:px-8 mt-12 mb-20">
          <h2 class="text-h2 font-bold mb-8 text-text">Verwante artikelen</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {cluster.relatedClusters.map((r: any) => (
              <a href={`/clusters/${r.slug}/`} class="block p-6 bg-bg-elevated border border-border rounded-lg hover:border-brand-primary no-underline transition">
                <div class="font-semibold text-text mb-2">{r.title}</div>
                {r.subtitle && <div class="text-small text-text-secondary">{r.subtitle}</div>}
              </a>
            ))}
          </div>
        </section>
      )}

    {ctaContext ? <CTABand heading={ctaContext.heading} description={ctaContext.description} /> : <CTABand />}
  </article>
</BaseLayout>
