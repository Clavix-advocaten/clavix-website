---
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout
  ogImage="/og/en-contact.png"
  title="Contact | Clavix Advocaten Amsterdam"
  description="Contact Clavix Advocaten: Strawinskylaan 257, Amsterdam Zuidas (WTC area). Phone +31 20 747 1121, info@clavix.nl. Response within 24 hours on business days."
  lang="en"
  ogLocale="en_US"
  alternates={[
    { hreflang: 'nl', href: '/contact/' },
    { hreflang: 'en', href: '/en/contact/' },
    { hreflang: 'x-default', href: '/contact/' },
  ]}
>
  <section class="bg-bg-tinted">
    <div class="max-w-container mx-auto px-4 md:px-8 py-16 md:py-24">
      <p class="text-tiny font-semibold uppercase tracking-wider text-text-secondary mb-3">
        <a href="/en/" class="text-text-secondary no-underline hover:underline">English</a> › Contact
      </p>
      <h1 class="text-display font-extrabold text-text mb-3 tracking-tight">Contact</h1>
      <p class="text-lead text-text-secondary max-w-readable">
        Call, e-mail or visit us at the Zuidas. On business days we respond within 24 hours; urgent matters, such as an attachment or an expiring deadline, are usually returned the same day.
      </p>
    </div>
  </section>

  <section class="max-w-container mx-auto px-4 md:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <h2 class="text-h4 font-bold text-text mb-2">Visiting address</h2>
        <p class="text-body text-text-secondary">Strawinskylaan 257<br />1077 XX Amsterdam<br />World Trade Center area, Zuidas</p>
      </div>
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <h2 class="text-h4 font-bold text-text mb-2">Getting here</h2>
        <p class="text-body text-text-secondary">Parking in the WTC garage. Amsterdam Zuid station (train and metro) is a few minutes' walk, with a direct connection to Schiphol Airport.</p>
      </div>
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <h2 class="text-h4 font-bold text-text mb-2">Direct contact</h2>
        <p class="text-body text-text-secondary">
          <a href="tel:+31207471121" class="text-brand-primary no-underline hover:underline">+31 20 747 1121</a><br />
          <a href="mailto:info@clavix.nl" class="text-brand-primary no-underline hover:underline">info@clavix.nl</a><br />
          Response within 24 hours on business days
        </p>
      </div>
    </div>
    <section id="success-message-en" role="status" class="mt-12 p-6 bg-brand-primary text-white rounded-lg" style="display: none;">
      <h2 class="text-h3 font-bold mb-2">Your message has been sent</h2>
      <p class="text-body">
        Thank you for reaching out. On business days you will hear from us within 24 hours; urgent matters are usually returned the same day.
      </p>
    </section>

    <div class="mt-12 grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <h2 class="text-h2 font-bold text-text mb-2">Or use the form</h2>
        <p class="text-body text-text-secondary mb-6">A short description of your situation is enough; the more context you give, the more focused our response can be.</p>
        <form name="contact-en" method="POST" action="/en/contact/?success=true" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5 p-6 bg-bg-elevated border border-border rounded-lg">
          <input type="hidden" name="form-name" value="contact-en" />
          <p class="hidden"><label>Do not fill in: <input name="bot-field" /></label></p>
          <div>
            <label for="en-name" class="block text-small font-semibold text-text mb-2">Your name <span class="text-brand-primary">*</span></label>
            <input type="text" id="en-name" name="name" required class="w-full px-4 py-3 border border-border rounded-md bg-white text-text focus:outline-none focus:border-brand-primary" />
          </div>
          <div>
            <label for="en-email" class="block text-small font-semibold text-text mb-2">E-mail address <span class="text-brand-primary">*</span></label>
            <input type="email" id="en-email" name="email" required class="w-full px-4 py-3 border border-border rounded-md bg-white text-text focus:outline-none focus:border-brand-primary" />
          </div>
          <div>
            <label for="en-phone" class="block text-small font-semibold text-text mb-2">Phone number <span class="text-text-muted text-tiny font-normal">(optional)</span></label>
            <input type="tel" id="en-phone" name="phone" class="w-full px-4 py-3 border border-border rounded-md bg-white text-text focus:outline-none focus:border-brand-primary" />
          </div>
          <div>
            <label for="en-message" class="block text-small font-semibold text-text mb-2">Brief description of your situation <span class="text-text-muted text-tiny font-normal">(optional)</span></label>
            <textarea id="en-message" name="message" rows="5" placeholder="For example: a Dutch counterparty has stopped paying, a dispute has arisen with a co-shareholder, you are buying Dutch commercial property..." class="w-full px-4 py-3 border border-border rounded-md bg-white text-text focus:outline-none focus:border-brand-primary"></textarea>
          </div>
          <button type="submit" class="w-full md:w-auto bg-brand-primary text-white font-semibold px-8 py-3 rounded-lg hover:opacity-90 transition cursor-pointer">Send</button>
          <p class="text-tiny text-text-muted">By sending this form you confirm that we may contact you using the details provided. Your information is not shared with third parties and is covered by legal professional privilege.</p>
        </form>
      </div>
      <aside class="p-6 bg-bg-tinted border border-border rounded-lg h-fit">
        <h2 class="text-h4 font-bold text-text mb-2">Urgent matter?</h2>
        <p class="text-small text-text-secondary mb-4">A prejudgment attachment, an expiring deadline or a bankruptcy petition: call us directly. We are available the same week.</p>
        <a href="tel:+31207471121" class="inline-block bg-brand-primary text-white font-semibold px-5 py-2 rounded-md no-underline hover:opacity-90 transition text-small">Call +31 20 747 1121</a>
      </aside>
    </div>

    <div class="max-w-readable mt-10">
      <p class="text-body text-text-secondary">
        Company details: Clavix B.V., Chamber of Commerce (KvK) 96800747, VAT NL867766839B01. mr. M. Kumar is a member of the Netherlands Bar (Nederlandse Orde van Advocaten), registered in the register of practice areas for corporate law and civil procedure.
      </p>
      <a href="https://www.google.com/maps?cid=7869689075875714479" target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-small font-semibold text-brand-primary no-underline hover:underline">Directions via Google Maps →</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('success') === 'true') {
      var s = document.getElementById('success-message-en');
      if (s) {
        s.style.display = 'block';
        s.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      }
      if (window.plausible) window.plausible('Contact EN verzonden');
    }
  })();
</script>
