---
import BaseLayout from '@layouts/BaseLayout.astro'
import { breadcrumbSchema } from '@lib/schema-markup'

const faqs = [
  {
    q: 'Voor wie is het Clavix-netwerk?',
    a: 'Voor ondernemers, DGA\'s en investeerders die willen dat juridische zaken geregeld zijn vóórdat ze gaan spelen — in het bijzonder waar ondernemen en vastgoed elkaar raken. Van de verhuurder met drie panden tot de holding met meerdere werkmaatschappijen.',
  },
  {
    q: 'Wat kost deelname?',
    a: 'De bijdrage hangt af van de vorm die bij uw onderneming past: van een vaste lijn met uw advocaat tot volledige begeleiding met strategie en netwerk. Dat bespreken wij in het kennismakingsgesprek, en u weet het dus vóórdat u ergens aan vastzit — vaste bedragen, geen verrassingen.',
  },
  {
    q: 'Hoe word ik lid?',
    a: 'U laat uw gegevens achter, wij nemen binnen enkele werkdagen contact op, en dan volgt een kennismakingsgesprek. Daarin kijken we samen of uw onderneming en het netwerk bij elkaar passen. Is dat wederzijds het geval, dan sluit u aan.',
  },
  {
    q: 'Wat gebeurt er als een vraag een dossier of procedure wordt?',
    a: 'Dan hoort u dat direct en krijgt u voorrang in de agenda. Het grote verschil met een los dossier: wij kennen uw onderneming dan al — de bijstand begint op dag één, niet na een week inlezen.',
  },
]

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Juridisch abonnement', url: '/juridisch-abonnement' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]

const waarde = [
  {
    titel: 'Uw vaste advocaat, onder de sneltoets',
    tekst: 'Eén nummer, één advocaat die uw onderneming, uw structuur en uw contracten kent. Twijfelt u over een brief, een clausule of een lastig gesprek dat eraan komt? U belt, wij kijken mee — dat tweede paar ogen op het juiste moment is precies het verschil tussen een detail en een dossier.',
  },
  {
    titel: 'Problemen voorkomen in plaats van oplossen',
    tekst: 'Wij zien dagelijks waar het bij ondernemers misgaat: het contract dat te snel getekend is, de structuur die bij groei gaat knellen, de huurder die te lang krediet kreeg. Leden profiteren van die praktijkkennis vóórdat het geld kost — de meeste geschillen die wij uitvechten, waren in dit stadium een telefoontje geweest.',
  },
  {
    titel: 'De beste contracten, niet de snelste',
    tekst: 'Uw overeenkomsten, algemene voorwaarden en huurcontracten worden opgebouwd en onderhouden door iemand die weet waar ze scheuren als het spannend wordt. Wie op stevige contracten staat, onderhandelt anders: met zekerheid in plaats van hoop.',
  },
  {
    titel: 'Sparringpartner bij twijfel en groei',
    tekst: 'Een overname overwegen, een compagnon uitkopen, een tweede vestiging, een lastige medewerker? Voor leden is de advocaat geen brandweer maar een sparringpartner: periodieke strategiegesprekken en een jaarlijkse doorlichting van onderneming, structuur en contracten. Waar wilt u over drie jaar staan — en wat moet daarvoor nú geregeld zijn?',
  },
  {
    titel: 'Een voorsprong op wet- en regelgeving',
    tekst: 'Regels, tarieven en rechtspraak veranderen doorlopend. Leden horen niet wát er verandert, maar wat het voor hún onderneming betekent — vaak voordat het in het nieuws is, met een persoonlijk seintje als iets uw situatie raakt. Terwijl anderen nog uitzoeken wat de nieuwe regels betekenen, heeft u al geschakeld.',
  },
  {
    titel: 'Gelijkgestemden binnen én buiten uw branche',
    tekst: 'Aan tafel met ondernemers uit uw eigen branche hoort u wat werkt en wat niet — van huurstrategie tot personeelsaanpak. En het netwerk buiten uw branche brengt wat elk bedrijf nodig heeft: klanten, leveranciers en samenwerkingen. Leden gunnen elkaar het werk; ondernemers helpen ondernemers.',
  },
  {
    titel: 'Evenementen die wat opleveren',
    tekst: 'Besloten rondetafels op de Zuidas, borrels waar de gesprekken nergens anders gevoerd worden, en netwerkreizen met een klein gezelschap. Plus introducties in ons netwerk van accountants, notarissen, fiscalisten en makelaars — de juiste specialist is voor leden één telefoontje ver.',
  },
  {
    titel: 'Ledenvoordelen die optellen',
    tekst: 'Een vast voorrangstarief bij Clavix zodra iets een dossier wordt. Onderlinge ledenvoordelen bij de ondernemers in het netwerk. En als eerste toegang tot alles wat wij nieuw bouwen — van modelcontracten tot rekentools. Het lidmaatschap verdient zichzelf op meer manieren dan één terug.',
  },
  {
    titel: 'Als het tóch misgaat, staat u er niet alleen voor',
    tekst: 'Raakt uw onderneming in de problemen, dan weten wij uit de dagelijkse praktijk hoe die zich het beste laten oplossen — en vaak vloeit er juist dán iets nieuws uit voort: binnen het netwerk helpen ondernemers elkaar graag, en waar het eerst knelde, bloeit geregeld een samenwerking op. Vraagt een conflict om een andere route, dan hebben we ervaren mediators binnen het netwerk. En komt het toch tot een rechtszaak, dan voeren wij die voor u — als kantoor dat uw onderneming door en door kent.',
  },
]
---

<BaseLayout
  title="Juridisch abonnement: uw huisadvocaat op de Zuidas | Clavix"
  description="Het Clavix-netwerk: een huisadvocaat die problemen voorkomt, een netwerk dat deuren opent en als eerste weten wat uw onderneming raakt. Voor ondernemers die bij Clavix passen."
  schemaJsonLd={schemas}
>
  {/* === HERO === */}
  <section class="bg-bg-tinted">
    <div class="max-w-container mx-auto px-4 md:px-8 py-16 md:py-24">
      <p class="text-tiny font-semibold uppercase tracking-wider text-brand-primary mb-3">
        Het Clavix-netwerk · exclusief voor ondernemers die bij ons passen
      </p>
      <h1 class="text-display font-extrabold text-text mb-3 tracking-tight max-w-4xl">
        Een huisadvocaat, een netwerk en een voorsprong
      </h1>
      <p class="text-h3 text-text-secondary font-display font-semibold mb-6 italic">
        Voor ondernemers die problemen vóór willen zijn in plaats van ze op te lossen.
      </p>
      <p class="text-lead text-text-secondary mb-8 max-w-readable">
        De duurste juridische vraag is de vraag die te laat wordt gesteld: het contract dat al getekend is, de huurder die al maanden niet betaalt, de aandeelhouder die al een advocaat heeft. Leden van het Clavix-netwerk bellen vóór ze tekenen, weten eerder wat er verandert, en zitten aan tafel met ondernemers en specialisten die hen verder brengen.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#aanmelden" class="bg-action text-action-fg hover:bg-action-hover px-7 py-3.5 rounded-md font-semibold no-underline transition inline-block">Laat uw gegevens achter</a>
        <a href="#waarde" class="border border-border bg-bg-elevated text-text px-7 py-3.5 rounded-md font-semibold no-underline transition inline-block hover:border-brand-primary">Wat het netwerk u brengt</a>
      </div>
    </div>
  </section>

  {/* === WAARDE === */}
  <section id="waarde" class="max-w-container mx-auto px-4 md:px-8 py-20 scroll-mt-24">
    <h2 class="text-h2 font-bold mb-2 text-text">Wat het Clavix-netwerk u brengt</h2>
    <p class="text-body text-text-secondary mb-10 max-w-readable">
      Geen strippenkaart en geen verzekering, maar een vaste plek aan tafel: juridisch, strategisch en zakelijk. Leden ondernemen met meer zekerheid — en wie zeker van zijn zaak is, beslist sneller.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {waarde.map((w) => (
        <div class="p-7 bg-bg-elevated border border-border rounded-lg">
          <h3 class="text-h4 font-bold text-text mb-2">{w.titel}</h3>
          <p class="text-body text-text-secondary">{w.tekst}</p>
        </div>
      ))}
    </div>
  </section>

  {/* === VOOR WIE === */}
  <section class="bg-bg-tinted py-20">
    <div class="max-w-container mx-auto px-4 md:px-8">
      <h2 class="text-h2 font-bold mb-2 text-text">Exclusief — omdat het moet passen</h2>
      <p class="text-body text-text-secondary mb-8 max-w-readable">
        Iedere ondernemer kan zich aanmelden, maar niet iedere onderneming sluit aan. Niet omdat wij het klein willen houden, maar omdat het netwerk werkt bij de gratie van wie eraan deelneemt. Wij kijken in het kennismakingsgesprek naar drie dingen:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-bg-elevated border border-border rounded-lg">
          <h3 class="text-h4 font-bold text-text mb-2">U onderneemt</h3>
          <p class="text-body text-text-secondary">Het netwerk is er voor ondernemers, DGA's en investeerders — mensen die beslissingen nemen waar juridische gevolgen aan hangen, en die dat liever vooraf dan achteraf geregeld zien.</p>
        </div>
        <div class="p-6 bg-bg-elevated border border-border rounded-lg">
          <h3 class="text-h4 font-bold text-text mb-2">Uw vraagstukken passen bij ons</h3>
          <p class="text-body text-text-secondary">Ondernemingsrecht, vastgoed en huur, contracten, incasso en procederen — het snijvlak waar wij dagelijks op werken. Ligt uw zwaartepunt elders, dan zeggen wij dat eerlijk en verwijzen wij u goed door.</p>
        </div>
        <div class="p-6 bg-bg-elevated border border-border rounded-lg">
          <h3 class="text-h4 font-bold text-text mb-2">Het klikt van twee kanten</h3>
          <p class="text-body text-text-secondary">U werkt direct met de advocaat en zit aan tafel met andere leden. Vertrouwen en een goede verstandhouding zijn dus geen bijzaak maar een toelatingseis — en dat toetsen we in een gesprek, niet met een formulier.</p>
        </div>
      </div>
    </div>
  </section>

  {/* === ZO WERKT HET === */}
  <section class="max-w-container mx-auto px-4 md:px-8 py-20">
    <h2 class="text-h2 font-bold mb-8 text-text">Zo werkt aansluiten</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <p class="text-h2 font-extrabold text-brand-primary mb-2">1</p>
        <h3 class="text-h4 font-bold text-text mb-2">U laat uw gegevens achter</h3>
        <p class="text-body text-text-secondary">Twee minuten werk: wie u bent, wat u onderneemt en waar uw juridische vragen zitten. Het verplicht u tot niets.</p>
      </div>
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <p class="text-h2 font-extrabold text-brand-primary mb-2">2</p>
        <h3 class="text-h4 font-bold text-text mb-2">Wij nemen contact op</h3>
        <p class="text-body text-text-secondary">Binnen enkele werkdagen belt mr. Kumar u persoonlijk voor een eerste verkenning en het inplannen van de kennismaking.</p>
      </div>
      <div class="p-6 bg-bg-elevated border border-border rounded-lg">
        <p class="text-h2 font-extrabold text-brand-primary mb-2">3</p>
        <h3 class="text-h4 font-bold text-text mb-2">Kennismaking op de Zuidas</h3>
        <p class="text-body text-text-secondary">In een goed gesprek kijken we of uw onderneming en het netwerk elkaar versterken — en welke vorm van deelname bij u past. Klikt het van twee kanten, dan sluit u aan.</p>
      </div>
    </div>
  </section>

  {/* === AANMELDEN === */}
  <section id="aanmelden" class="bg-bg-tinted py-20 scroll-mt-24">
    <div class="max-w-container mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <div>
          <h2 class="text-h2 font-bold mb-4 text-text">Laat uw gegevens achter</h2>
          <p class="text-body text-text-secondary mb-4 max-w-readable">
            Vertel kort wie u bent en wat u onderneemt. Wij nemen persoonlijk contact met u op voor een kennismakingsgesprek — daarin bespreken we ook de vormen van deelname en wat daarbij hoort.
          </p>
          <p class="text-body text-text-secondary max-w-readable">
            Liever eerst een concrete juridische vraag voorleggen? Dat kan altijd via een <a href="/contact" class="text-brand-primary no-underline hover:underline">verkennend gesprek</a>.
          </p>
        </div>
        <div>
          <div id="ab-form-wrap" class="p-6 bg-bg-elevated border border-border rounded-lg">
            <form name="abonnement-aanmelding" method="POST" action="/juridisch-abonnement?aangemeld=true" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
              <p class="hidden"><label>Niet invullen: <input name="bot-field" /></label></p>
              <input type="hidden" name="form-name" value="abonnement-aanmelding" />
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="ab-naam" class="block text-small font-semibold text-text mb-1">Uw naam *</label>
                  <input id="ab-naam" name="naam" type="text" required class="w-full p-3 border border-border rounded-md bg-bg text-text" />
                </div>
                <div>
                  <label for="ab-bedrijf" class="block text-small font-semibold text-text mb-1">Onderneming *</label>
                  <input id="ab-bedrijf" name="bedrijf" type="text" required class="w-full p-3 border border-border rounded-md bg-bg text-text" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="ab-email" class="block text-small font-semibold text-text mb-1">E-mailadres *</label>
                  <input id="ab-email" name="email" type="email" required class="w-full p-3 border border-border rounded-md bg-bg text-text" />
                </div>
                <div>
                  <label for="ab-telefoon" class="block text-small font-semibold text-text mb-1">Telefoon</label>
                  <input id="ab-telefoon" name="telefoon" type="tel" class="w-full p-3 border border-border rounded-md bg-bg text-text" />
                </div>
              </div>
              <div>
                <label for="ab-toelichting" class="block text-small font-semibold text-text mb-1">Uw onderneming en juridische vragen *</label>
                <textarea id="ab-toelichting" name="toelichting" rows="4" required placeholder="Bijv.: verhuur van drie bedrijfspanden, terugkerende contract- en incassovragen, plannen voor een overname." class="w-full p-3 border border-border rounded-md bg-bg text-text"></textarea>
              </div>
              <button type="submit" class="w-full bg-brand-primary text-white font-semibold px-8 py-3 rounded-lg hover:opacity-90 transition cursor-pointer">Verstuur en word teruggebeld</button>
              <p class="text-tiny text-text-secondary">Wij gebruiken uw gegevens uitsluitend om contact met u op te nemen.</p>
            </form>
          </div>
          <div id="ab-succes" style="display: none;" class="p-6 bg-bg-elevated border-2 border-brand-primary rounded-lg">
            <h3 class="text-h3 font-bold mb-2 text-text">Uw gegevens zijn ontvangen</h3>
            <p class="text-body text-text-secondary">Dank — mr. Kumar neemt binnen enkele werkdagen persoonlijk contact met u op voor de kennismaking. Tot die tijd staan de <a href="/proceskosten-berekenen/" class="text-brand-primary no-underline hover:underline">rekentools</a> en <a href="/modelbrieven/" class="text-brand-primary no-underline hover:underline">modelbrieven</a> al voor u klaar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* === FAQ === */}
  <section class="max-w-container mx-auto px-4 md:px-8 py-20">
    <h2 class="text-h2 font-bold mb-8 text-text">Veelgestelde vragen</h2>
    <div class="space-y-4 max-w-readable">
      {faqs.map((f) => (
        <div class="p-6 bg-bg-elevated border border-border rounded-lg">
          <h3 class="text-h4 font-bold text-text mb-2">{f.q}</h3>
          <p class="text-body text-text-secondary">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get('aangemeld') === 'true') {
        window.plausible && window.plausible('Abonnement aanmelding');
        var f = document.getElementById('ab-form-wrap');
        var s = document.getElementById('ab-succes');
        if (f) f.style.display = 'none';
        if (s) { s.style.display = 'block'; s.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      }
    })();
  </script>
</BaseLayout>
