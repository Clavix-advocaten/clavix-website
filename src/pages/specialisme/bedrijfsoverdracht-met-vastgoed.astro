---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import AnswerCapsule from '../../components/AnswerCapsule.astro';
import { serviceSchema, breadcrumbSchema } from '@lib/schema-markup';

const pageTitle = "Bedrijfsoverdracht met vastgoed";
const pageDescription = "Advocaat voor commerciële vastgoedtransacties en bedrijfsoverdracht met vastgoed: structuur, due diligence, garanties en vrijwaringen, earn-outs en levering.";

const voorWie = [
  {
    titel: "DGA's met exit-perspectief",
    omschrijving: "DGA's die hun onderneming overwegen te verkopen en zich afvragen wat er met het bedrijfspand moet gebeuren. Houden of mee verkopen, in een vastgoed-BV of in privé, met of zonder lopende huurovereenkomst aan de overnemer.",
  },
  {
    titel: 'Familiebedrijven bij generatiewisseling',
    omschrijving: 'Ondernemingen waarbij de overdracht naar de volgende generatie wordt voorbereid en waarbij vastgoed een belangrijke component is. Bedrijfsopvolgingsregeling (BOR), schenkingsstructuur, en de positie van familieleden die niet in de onderneming werken.',
  },
  {
    titel: 'Beleggers en strategische kopers',
    omschrijving: 'Partijen die een onderneming overnemen waarbij vastgoed onderdeel is van de structuur. Beoordeling van de structuur, vrijwaringen voor vastgoed-aansprakelijkheid (milieu, oplevering, lopende geschillen), en lange-termijn huurarrangementen.',
  },
  {
    titel: 'Ondernemers in pre-exit-herstructurering',
    omschrijving: "Ondernemers die nog jaren weg zijn van een verkoop, maar hun structuur al willen voorbereiden. Vastgoed afsplitsen, holdingstructuur opzetten, fiscaal optimaliseren, en paulianeuze risico's vermijden door tijdig te handelen.",
  },
];

const watWeDoen = [
  'Beoordeling van uw bestaande holding- en vastgoedstructuur in het licht van een toekomstige overdracht',
  "Splitsing van werkmaatschappij en vastgoed-BV met aandacht voor timing, overdrachtsbelasting, en pauliana-risico's",
  'Onderhandeling over de prijs van werkmaatschappij versus vastgoed bij externe overdracht',
  'Opstellen van lange-termijn huurovereenkomsten tussen verkopende DGA en overnemende werkmaatschappij',
  'SPA-bepalingen voor vastgoedcomponent: earn-outs, vrijwaringen, terugkooprechten, exit-arrangementen',
];

const aanpak = [
  {
    nummer: '01',
    titel: 'Drie waardes naast elkaar',
    omschrijving: 'Eerst beoordelen wij de drie waarde-lagen tegelijk: de operationele waarde van de onderneming, de vastgoedwaarde, en uw persoonlijke vermogensdoelen na de transactie. De optimale structuur voor de DGA verschilt aanzienlijk per situatie en is zelden alleen vanuit een M&A- of vastgoed-perspectief te beoordelen.',
  },
  {
    nummer: '02',
    titel: 'Strategische voorbereiding',
    omschrijving: 'Een goede bedrijfsoverdracht met vastgoed wordt twaalf tot achttien maanden voorbereid. Herstructurering van de holdingstructuur, fiscaal vooroverleg met de Belastingdienst, en het op orde brengen van de huurrelaties tussen groepsmaatschappijen voorkomen problemen tijdens en na de transactie.',
  },
  {
    nummer: '03',
    titel: 'Transactiebegeleiding',
    omschrijving: 'Wanneer de transactie zich aandient, voeren wij de juridische begeleiding: SPA-onderhandelingen met aandacht voor de vastgoedcomponent, leveringsdocumenten voor zowel aandelen als eventueel vastgoed, en de na-deal-arrangementen tussen verkopende DGA en kopende partij.',
  },
];

const onderscheid = [
  {
    titel: 'M&A en vastgoed in één hand',
    omschrijving: 'Bij ons doet één advocaat de koopovereenkomst én het pand. Mr. Kumar staat bij de NOvA geregistreerd voor ondernemingsrecht en vastgoedrecht, zodat er geen overdrachtsmoment tussen twee teams zit.',
  },
  {
    titel: 'Vroege betrokkenheid, niet alleen deal-fase',
    omschrijving: "De grootste waarde voor de DGA ontstaat in de jaren voor een verkoop, niet in de zes weken erna. Wij werken graag al in de pre-exit-fase, wanneer de structuur nog flexibel is en herstructurering zonder tijdsdruk en pauliana-risico's kan plaatsvinden.",
  },
  {
    titel: 'Persoonlijke begeleiding bij een gevoelig moment',
    omschrijving: "De verkoop van een onderneming met bedrijfspand is voor de meeste DGA's een eenmalige ervaring met grote financiële en emotionele impact. U heeft direct contact met de behandelend advocaat.",
  },
];

const faqs = [
  {
    "vraag": "Verkoop ik de aandelen of het pand apart?",
    "antwoord": "Dat is de eerste en meest bepalende vraag. Bij een aandelentransactie blijft het pand in de vennootschap en gaan alle rechten en verplichtingen mee, inclusief de risico's die u niet kent. Bij een activatransactie wordt het pand expliciet geleverd en kiest u wat meegaat, maar moeten contracten afzonderlijk worden overgedragen met medewerking van de wederpartij en gaat personeel van rechtswege mee als overgang van onderneming. De keuze heeft ook aanzienlijke fiscale gevolgen, waaronder overdrachtsbelasting; laat haar daarom altijd samen met uw fiscalist maken en niet uit gewoonte."
  },
  {
    "vraag": "Wat gebeurt er met de huurovereenkomst als het bedrijf wordt overgenomen?",
    "antwoord": "Huurt de onderneming het pand van een derde, dan hangt het af van de transactiestructuur. Bij een aandelentransactie verandert de huurder juridisch niet: dezelfde vennootschap blijft contractspartij, al kan een change-of-controlbeding in het huurcontract de verhuurder rechten geven. Bij een activatransactie gaat de huur niet automatisch mee; dan is contractsoverneming met medewerking van de verhuurder nodig, of, bij 290-bedrijfsruimte, de afdwingbare route van indeplaatsstelling via de kantonrechter. Breng dit vroeg in het traject in kaart: de verhuurder is geen partij bij uw deal maar wel bij uw locatie."
  },
  {
    "vraag": "Welke vrijwaringen zijn gebruikelijk als er vastgoed in de transactie zit?",
    "antwoord": "Naast de gewone garanties zijn bij vastgoed vier onderwerpen standaard: bodemverontreiniging en milieu, de bouwkundige staat en verborgen gebreken, publiekrechtelijke beperkingen zoals bestemming en vergunningen, en de huurrechtelijke positie met lopende verplichtingen. Voor bekende risico's wordt doorgaans een specifieke vrijwaring opgenomen in plaats van een garantie, omdat een garantie alleen dekt wat op dat moment onbekend was. Laat het boekenonderzoek op vastgoed niet beperken tot de eigendomsakte: de aangehaalde oudere aktes bevatten geregeld erfdienstbaarheden of kwalitatieve verplichtingen die het gebruik beperken."
  }
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.vraag,
      acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
    })),
  },
  serviceSchema({
    name: 'Bedrijfsoverdracht met vastgoed',
    description: 'M&A-transacties waar vastgoed onderdeel van is. Earn-outs, vrijwaringen, transactiestructuur, en juridische due diligence.',
    url: '/specialisme/bedrijfsoverdracht-met-vastgoed/',
    serviceType: 'M&A-advies met vastgoed-component',
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Specialisme', url: '/' },
    { name: 'Bedrijfsoverdracht met vastgoed', url: '/specialisme/bedrijfsoverdracht-met-vastgoed/' },
  ]),
];
---

<BaseLayout ogImage="/og/specialisme-bedrijfsoverdracht-met-vastgoed.png" title={pageTitle} description={pageDescription}
  schemaJsonLd={schemas}
>
  <article>
    {/* === HERO === */}
    <section class="bg-bg-tinted">
      <div class="max-w-container mx-auto px-4 md:px-8 py-12 md:py-16">
        <p class="text-tiny text-text-muted uppercase tracking-wider mb-4">
          Specialisme
        </p>
        <h1 class="text-display font-extrabold text-text mb-3 tracking-tight">
          Bedrijfsoverdracht met vastgoed
        </h1>
        <p class="text-small text-text-secondary mb-4">Door <a href="/kumar/" class="text-text font-semibold underline hover:text-text-accent">mr. M. Kumar</a> · NOvA-geregistreerd advocaat</p>
        <p class="text-h3 text-text-secondary font-display font-semibold mb-6 italic">
          Commerciële vastgoedtransacties: wanneer uw onderneming wordt verkocht en het bedrijfspand mee, of juist niet.
        </p>
        <p class="text-body text-text-secondary max-w-prose mb-8">
          Voor DGA's, familiebedrijven, en ondernemers waar vastgoed een wezenlijk onderdeel uitmaakt van de structuur of de transactie. Wij combineren M&A-praktijk en vastgoedrecht in één hand, en werken liever vroeg dan laat — wie twaalf tot achttien maanden vooruit werkt, kan het pand nog afsplitsen met de fiscale faciliteiten voor herstructurering, in plaats van te herstructureren vlak voor een deal.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact/" class="inline-block bg-brand-primary text-white font-semibold px-6 py-3 rounded-lg no-underline hover:opacity-90 transition">
            Plan een eerste gesprek
          </a>
        </div>
        <p class="text-small text-text-secondary mt-4">
          <a href="/clusters/verkoop-bedrijfspand-mna/" class="text-brand-primary underline">Lees eerst onze uitgebreide analyse</a> als u zich wilt inlezen.
        </p>
        
      </div>
    </section>

    <div class="max-w-container mx-auto px-4 md:px-8 py-16">

      <div class="max-w-readable">
        <AnswerCapsule text="Bij een bedrijfsoverdracht waar vastgoed in de structuur zit, bepalen transactiestructuur (aandelen of activa), garanties en vrijwaringen, en de fiscale route het eindresultaat. Wij begeleiden kopers en verkopers in het MKB van intentieverklaring tot levering, met bijzondere aandacht voor het pand: huurverhoudingen, overdrachtsbelasting en de waardering daarvan in de koopprijs." />
      </div>

      {/* === VOOR WIE === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Voor wie</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Bedrijfsoverdrachten met een vastgoedcomponent treffen partijen in verschillende stadia. Wij staan vier doelgroepen bij.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          {voorWie.map(item => (
            <div class="p-5 bg-bg-elevated border border-border rounded-lg">
              <h3 class="text-h4 font-bold text-text mb-2">{item.titel}</h3>
              <p class="text-small text-text-secondary">{item.omschrijving}</p>
            </div>
          ))}
        </div>
      </section>

      {/* === WAARBIJ WIJ ONDERSTEUNEN === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Waarbij wij ondersteunen</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Vijf typische trajecten waarvoor cliënten ons inschakelen.
        </p>
        <ul class="space-y-3">
          {watWeDoen.map(item => (
            <li class="flex gap-3 items-start p-4 bg-bg-elevated border border-border rounded-lg">
              <span class="text-brand-primary font-bold flex-shrink-0">→</span>
              <span class="text-body text-text">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* === ONZE AANPAK === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Onze aanpak</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Drie stappen, in deze volgorde. De grootste waarde ontstaat in de voorbereiding, niet in de transactie zelf.
        </p>
        <div class="grid md:grid-cols-3 gap-4">
          {aanpak.map(stap => (
            <div class="p-5 bg-bg-elevated border border-border rounded-lg">
              <div class="text-tiny text-brand-primary font-bold mb-2 tracking-wider">{stap.nummer}</div>
              <h3 class="text-h4 font-bold text-text mb-2">{stap.titel}</h3>
              <p class="text-small text-text-secondary">{stap.omschrijving}</p>
            </div>
          ))}
        </div>
      </section>

      {/* === WAT ONS ONDERSCHEIDT === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Wat ons onderscheidt</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Drie specifieke kenmerken van onze bedrijfsoverdracht-praktijk met vastgoedcomponent.
        </p>
        <div class="space-y-4">
          {onderscheid.map(item => (
            <div class="p-5 bg-bg-elevated border border-border rounded-lg">
              <h3 class="text-h4 font-bold text-text mb-2">{item.titel}</h3>
              <p class="text-body text-text-secondary">{item.omschrijving}</p>
            </div>
          ))}
        </div>
      </section>

      {/* === WAT VALT ERONDER === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Wat valt onder een commerciële vastgoedtransactie?</h2>
        <div class="max-w-readable space-y-4">
          <p class="text-body text-text">
            In de praktijk komen drie vormen langs, en de route verschilt per vorm. Bij een <strong class="text-text">activatransactie</strong> koopt u het pand zelf: de levering gaat via de notaris, de overdrachtsbelasting speelt direct, en lopende huurovereenkomsten gaan van rechtswege mee omdat koop geen huur breekt. Bij een <strong class="text-text">aandelentransactie</strong> koopt u de vennootschap waarin het pand zit, met haar hele verleden: verplichtingen, claims en fiscale posities komen mee, en de bescherming zit in de garanties en vrijwaringen. En bij een <strong class="text-text">bedrijfsoverdracht waar het pand onderdeel is van een grotere deal</strong> moet u eerst kiezen of het pand meegaat of achterblijft bij de verkoper, want die keuze bepaalt de structuur en de prijs.
          </p>
          <p class="text-body text-text">
            Wat in alle drie beslissend is: de staat van het huurdossier en van de erfpacht, of er bijzondere bepalingen in de akte staan, en of de bestemming het beoogde gebruik toelaat. Het due diligence op het pand is daarom geen bijlage bij de dealdocumentatie maar een eigen onderzoek, en de uitkomsten daarvan horen terug te komen in de koopprijs, in de garanties en in de leveringsafspraken.
          </p>
        </div>
      </section>

      {/* === VERDIEPING === */}
      <section class="mb-16 p-6 bg-bg-tinted border border-border rounded-lg">
        <h2 class="text-h3 font-bold text-text mb-2">Wilt u meer lezen?</h2>
        <p class="text-body text-text-secondary mb-4">
          Onze diepgaande analyses behandelen verschillende aspecten van bedrijfsoverdracht met vastgoed: de transactiestructuur en SPA-bepalingen bij M&A met vastgoed, de holdingstructuur die u in staat stelt flexibel te zijn bij een latere verkoop, de keuze tussen vastgoed in BV en privé, en specifiek de positie van familiebedrijven met vastgoed bij generatiewisseling.
        </p>
        <ul class="space-y-2">
          <li>
            <a href="/clusters/verkoop-bedrijfspand-mna/" class="inline-block text-brand-primary font-semibold no-underline hover:underline">
              Verkoop van een bedrijfspand bij M&A: earn-outs, vrijwaringen, en de transactiestructuur →
            </a>
          </li>
          <li>
            <a href="/clusters/vastgoed-bv-oprichten-holding-structuur/" class="inline-block text-brand-primary font-semibold no-underline hover:underline">
              Vastgoed-BV oprichten: de holdingstructuur die opties open houdt →
            </a>
          </li>
          <li>
            <a href="/clusters/vastgoed-in-bv-of-prive/" class="inline-block text-brand-primary font-semibold no-underline hover:underline">
              Vastgoed in BV of in privé: de keuze →
            </a>
          </li>
          <li>
            <a href="/clusters/familiebedrijf-vastgoed-opvolging/" class="inline-block text-brand-primary font-semibold no-underline hover:underline">
              Familiebedrijf en vastgoed: opvolging, schenking, en de bedrijfsopvolgingsregeling →
            </a>
          </li>
        </ul>
      </section>

      {/* === VEELGESTELDE VRAGEN === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Veelgestelde vragen</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Drie vragen die in vrijwel elk dossier terugkomen.
        </p>
        <div class="space-y-4">
          {faqs.map((f) => (
            <div class="p-5 bg-bg-elevated border border-border rounded-lg">
              <h3 class="text-h4 font-bold text-text mb-2">{f.vraag}</h3>
              <p class="text-body text-text-secondary">{f.antwoord}</p>
            </div>
          ))}
        </div>
      </section>


      {/* === WAT HET KOST === */}
      <section id="wat-het-kost" class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Wat het kost</h2>
        <p class="text-body text-text-secondary mb-4 max-w-prose">
          Bij een overname met vastgoed werken wij met een vaste prijs per fase: eerst de structuur en de intentiefase, daarna het boekenonderzoek en de contracten. Zo weet u vooraf wat elke stap kost en beslist u per fase over het vervolg.
        </p>
        <p class="text-body text-text-secondary mb-4 max-w-prose">
          Waar de omvang vooraf te overzien is, werken wij met een vaste prijs die vóór de opdrachtbevestiging vastligt. Is dat niet mogelijk, dan geldt een uurtarief met een maandelijkse specificatie en melden wij het tijdig wanneer een zaak anders loopt dan verwacht. Het eerste gesprek van dertig minuten is verkennend en kosteloos.
        </p>
        <p class="text-body text-text-secondary max-w-prose">
          Op de <a href="/kosten/" class="text-brand-primary no-underline hover:underline">kostenpagina</a> staan de griffierechten per instantie en de kostenopbouw per traject. Met onze rekenhulpen berekent u zelf het <a href="/proceskosten-berekenen/" class="text-brand-primary no-underline hover:underline">griffierecht</a>, de <a href="/wettelijke-rente-berekenen/" class="text-brand-primary no-underline hover:underline">wettelijke rente</a>, de <a href="/incassokosten-berekenen/" class="text-brand-primary no-underline hover:underline">incassokosten</a> en de proceskostenveroordeling.
        </p>
      </section>

      {/* === VERDIEPING KENNISBANK === */}
      <section class="mb-16">
        <h2 class="text-h2 font-bold text-text mb-2">Verdieping in de kennisbank</h2>
        <p class="text-body text-text-secondary mb-8 max-w-prose">
          Wilt u zich eerst inlezen? Deze pagina's behandelen het juridische kader in detail, met wetsartikelen, termijnen en praktijkvoorbeelden.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          <a href="/clusters/verkoop-bedrijfspand-mna/" class="block p-5 bg-bg-elevated border border-border rounded-lg no-underline hover:border-brand-primary transition">
            <h3 class="text-h4 font-bold text-text mb-1">Verkoop van een bedrijfspand bij M&A</h3>
            <p class="text-small text-text-secondary">Transactiestructuur, earn-outs en vrijwaringen voor vastgoedrisico's.</p>
          </a>
          <a href="/clusters/letter-of-intent/" class="block p-5 bg-bg-elevated border border-border rounded-lg no-underline hover:border-brand-primary transition">
            <h3 class="text-h4 font-bold text-text mb-1">De letter of intent</h3>
            <p class="text-small text-text-secondary">Wat de intentieovereenkomst wel en niet bindt, en de voorbehouden die erin horen.</p>
          </a>
          <a href="/clusters/geheimhoudingsverklaring-nda/" class="block p-5 bg-bg-elevated border border-border rounded-lg no-underline hover:border-brand-primary transition">
            <h3 class="text-h4 font-bold text-text mb-1">De geheimhoudingsverklaring (NDA)</h3>
            <p class="text-small text-text-secondary">Vertrouwelijke informatie beschermen tijdens het overnametraject.</p>
          </a>
          <a href="/clusters/bedrijfsopvolging/" class="block p-5 bg-bg-elevated border border-border rounded-lg no-underline hover:border-brand-primary transition">
            <h3 class="text-h4 font-bold text-text mb-1">Bedrijfsopvolging</h3>
            <p class="text-small text-text-secondary">Overdragen aan familie of management: structuur, zeggenschap en fasering.</p>
          </a>
        </div>
      </section>


    </div>

    <CTABand
      heading="Denkt u na over een bedrijfsoverdracht waarbij vastgoed een rol speelt?"
      description="Plan een eerste gesprek. We luisteren naar uw situatie en geven aan of, en hoe, wij u kunnen bijstaan."
    />
  </article>
</BaseLayout>
