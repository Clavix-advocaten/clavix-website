---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import { organizationSchema, breadcrumbSchema } from '@lib/schema-markup';

const pageTitle = 'Juridische woordenlijst';
const pageDescription = 'Begrippenlijst met juridische termen uit ondernemingsrecht, vastgoedrecht en insolventierecht — kort en helder uitgelegd voor ondernemers.';

interface Term {
  term: string;
  def: string;
  link?: string;
}

const terms: Term[] = [
  { term: 'Aandeelhoudersgeschil', def: 'Conflict tussen aandeelhouders binnen een BV over koers, uitkering, bestuur of exit. Vaak opgelost via mediation of de geschillenregeling (2:336a en 2:343 BW) bij de Ondernemingskamer.', link: '/clusters/50-50-aandeelhoudersgeschil-oplossen' },
  { term: 'Aandeelhoudersovereenkomst', def: 'Contract tussen aandeelhouders dat zaken regelt die niet in de statuten staan, zoals exit-mechanismen, drag-along, tag-along en geschillenregeling.', link: '/clusters/aandeelhoudersovereenkomst-minimaal' },
  { term: 'Activatransactie', def: 'Verkoop van bedrijfsactiva (machines, voorraad, IP) afzonderlijk in plaats van een verkoop van de aandelen. Veel gebruikt bij doorstart uit faillissement.', link: '/clusters/activatransactie-faillissement' },
  { term: 'AVA', def: 'Algemene Vergadering van Aandeelhouders: het besluitvormingsorgaan van een BV. Neemt onder meer besluiten over statutenwijziging, dividend, en decharge van bestuurders.' },
  { term: 'Beslag op aandelen', def: 'Conservatoire of executoriale maatregel waarmee een schuldeiser zekerheid neemt op aandelen in een vennootschap. Vereist verlof van de voorzieningenrechter (artikel 700 Rv).', link: '/clusters/beslag-op-aandelen' },
  { term: 'Bestuurdersaansprakelijkheid', def: 'Persoonlijke aansprakelijkheid van een bestuurder voor schade aan de vennootschap, aandeelhouders, of derden. Bij faillissement geldt artikel 2:248 BW (kennelijk onbehoorlijk bestuur).', link: '/clusters/bestuurdersaansprakelijkheid-faillissement' },
  { term: 'BOR', def: 'Bedrijfsopvolgingsregeling: fiscale faciliteit waardoor een familiebedrijf bij schenking of vererving (vrijwel) zonder schenk- of erfbelasting kan worden overgedragen.', link: '/clusters/familiebedrijf-vastgoed-opvolging' },
  { term: 'Bouwgeschil', def: 'Conflict tussen opdrachtgever en aannemer over uitvoering, oplevering, meerwerk, gebreken of UAV-voorwaarden bij een bouwproject.', link: '/clusters/bouwgeschil-aannemer-wanprestatie' },
  { term: 'BV', def: 'Besloten Vennootschap: rechtspersoon met aandelen die niet vrij overdraagbaar zijn. De meest gebruikte ondernemingsvorm in Nederland.' },
  { term: 'BW', def: 'Burgerlijk Wetboek: het Nederlandse civiele wetboek, opgedeeld in Boeken 1 t/m 10 en aanvullende boeken (zoals Boek 7 voor bijzondere overeenkomsten).' },
  { term: 'Canon', def: 'De jaarlijkse vergoeding die een erfpachter betaalt aan de eigenaar van de grond (vaak de gemeente). Kan periodiek worden herzien.', link: '/clusters/erfpacht-amsterdam-herziening' },
  { term: 'Concurrentiebeding', def: 'Contractuele beperking die een ex-aandeelhouder, ex-werknemer of ex-vennoot belet om concurrerende activiteiten te ontplooien gedurende een bepaalde periode en gebied.', link: '/clusters/concurrentiebeding-ex-aandeelhouders' },
  { term: 'Decharge', def: 'Het AVA-besluit dat een bestuurder ontheft van interne aansprakelijkheid voor zijn beleid in een bepaalde periode. Werkt alleen tegenover de aandeelhouders en alleen voor wat hen bekend was.', link: '/clusters/decharge-bestuurder' },
  { term: 'DGA', def: 'Directeur-Grootaandeelhouder: ondernemer die zowel bestuurder is als (vrijwel) alle aandelen bezit van zijn vennootschap. Vaak via een holdingstructuur.' },
  { term: 'Doorstart', def: 'Voortzetting van bedrijfsactiviteiten na faillissement, doorgaans via een activatransactie waarbij een (nieuwe) entiteit de levensvatbare delen overneemt.', link: '/clusters/pre-pack-doorstart' },
  { term: 'Drag-along', def: 'Clausule in een aandeelhoudersovereenkomst die meerderheidsaandeelhouders het recht geeft minderheidsaandeelhouders te dwingen mee te verkopen bij een exit.', link: '/clusters/aandeelhoudersovereenkomst-minimaal' },
  { term: 'ECLI', def: 'European Case Law Identifier: unieke identifier voor rechtspraak in Europa. Voorbeeld: ECLI:NL:HR:2024:1234 voor een uitspraak van de Hoge Raad.' },
  { term: 'Enquêteprocedure', def: 'Verzoek aan de Ondernemingskamer om wanbeleid binnen een vennootschap te onderzoeken. Kan leiden tot bijzondere voorzieningen zoals schorsing bestuurder of overdracht aandelen.' },
  { term: 'Erfpacht', def: 'Zakelijk recht waarbij iemand het volledige gebruik en genot heeft van andermans grond, tegen betaling van canon. In Amsterdam belangrijk voor commerciële vastgoedbeleggers.', link: '/clusters/erfpacht-amsterdam-herziening' },
  { term: 'Faillissement', def: 'Gerechtelijke procedure waarbij een onderneming wegens betalingsonmacht onder beheer van een curator wordt gesteld om vermogen te verdelen onder schuldeisers.', link: '/praktijkgebieden/insolventie-en-herstructurering' },
  { term: 'Geschillenregeling', def: 'Procedure (artikelen 2:336a en 2:343 BW) waarmee aandeelhouders elkaar kunnen dwingen tot overdracht of overname van aandelen bij een geschil. Verloopt sinds 1 januari 2025 rechtstreeks bij de Ondernemingskamer.', link: '/clusters/50-50-aandeelhoudersgeschil-oplossen' },
  { term: 'Holding', def: 'BV die aandelen bezit in een of meer werkmaatschappijen. Wordt vaak gebruikt om risico, vastgoed en winst te scheiden van operationele activiteiten.', link: '/clusters/vastgoed-bv-oprichten-holding-structuur' },
  { term: 'Indeplaatsstelling', def: 'Procedure waarbij een huurder van 290-bedrijfsruimte zijn huurrechten overdraagt aan een opvolger bij bedrijfsoverdracht (artikel 7:307 BW).', link: '/clusters/indeplaatsstelling-huurder' },
  { term: 'KvK', def: 'Kamer van Koophandel: het Nederlandse handelsregister. Verplichte inschrijving voor alle BV\'s, met openbare gegevens over bestuurders, aandeelhouders en statuten.' },
  { term: 'M&A', def: 'Mergers & Acquisitions: fusies en overnames. Omvat aandelentransacties, activatransacties, joint ventures en management buy-outs.', link: '/clusters/verkoop-bedrijfspand-mna' },
  { term: 'NOvA', def: 'Nederlandse Orde van Advocaten: de beroepsorganisatie van Nederlandse advocaten. Beheert de Verordening op de Advocatuur en de beroepsregels.' },
  { term: 'Ondernemingskamer', def: 'Bijzondere kamer van het Gerechtshof Amsterdam die zich richt op vennootschapsrechtelijke geschillen, enquêteprocedures en geschillenregeling.' },
  { term: 'Pauliana', def: 'Vernietigingsactie waarmee een curator (of schuldeiser) rechtshandelingen kan terugdraaien die de schuldeisers onverplicht hebben benadeeld vlak voor faillissement (artikel 42-47 Fw).', link: '/clusters/pauliana-actie-curator' },
  { term: 'Pre-pack', def: 'Voorbereide doorstart waarbij een onderneming, met behulp van een beoogd curator, de overdracht van bedrijfsactiviteiten al voor het faillissement vormgeeft.', link: '/clusters/pre-pack-doorstart' },
  { term: 'ROZ', def: 'Raad voor Onroerende Zaken: opstelt modellen voor huurovereenkomsten (ROZ-modellen) die in de praktijk veel worden gebruikt bij commercieel vastgoed.' },
  { term: 'Statuten', def: 'De juridische basisinrichting van een BV: kapitaal, aandelensoorten, bestuursstructuur, doelomschrijving en blokkeringsregeling. Openbaar via de KvK.', link: '/clusters/statuten-bv-wijzigen' },
  { term: 'Statutenwijziging', def: 'Wijziging van de statuten van een BV via een AVA-besluit, notariële akte en KvK-inschrijving. Vereist voor wezenlijke veranderingen in de vennootschapsstructuur.', link: '/clusters/statuten-bv-wijzigen' },
  { term: 'Tag-along', def: 'Clausule in een aandeelhoudersovereenkomst die minderheidsaandeelhouders het recht geeft mee te verkopen onder dezelfde voorwaarden als de meerderheid (de mee-verkooprecht).', link: '/clusters/aandeelhoudersovereenkomst-minimaal' },
  { term: 'UAV-2012', def: 'Uniforme Administratieve Voorwaarden voor de uitvoering van werken (versie 2012): standaardvoorwaarden voor traditionele bouwcontracten.', link: '/clusters/bouwgeschil-aannemer-wanprestatie' },
  { term: 'Vastgoed-BV', def: 'Aparte BV die uitsluitend onroerend goed bezit, vaak onder een holding. Scheidt het vastgoed van de operationele werkmaatschappij.', link: '/clusters/vastgoed-bv-oprichten-holding-structuur' },
  { term: 'Verzet', def: 'Rechtsmiddel waarmee een failliet verklaarde partij binnen 14 dagen verzet kan instellen tegen het faillissementsvonnis (artikel 8 Fw).', link: '/clusters/verzet-tegen-faillissement' },
  { term: 'Wanprestatie', def: 'Tekortkoming in de nakoming van een verplichting uit een overeenkomst. Geeft de wederpartij recht op nakoming, schadevergoeding of ontbinding.', link: '/clusters/bouwgeschil-aannemer-wanprestatie' },
  { term: 'WHOA', def: 'Wet Homologatie Onderhands Akkoord: sinds 2021 in werking. Maakt het mogelijk voor ondernemingen om buiten faillissement een dwangakkoord met schuldeisers af te dwingen.', link: '/clusters/whoa-traject-ondernemer-kosten-kansen' },
  { term: 'As is, where is', def: 'Contractsbeding waarmee een zaak — vaak vastgoed — wordt verkocht in de staat waarin zij zich bevindt, waarbij het risico van gebreken grotendeels naar de koper verschuift. De reikwijdte hangt af van de formulering en beschermt de verkoper niet die een bekend gebrek verzweeg.', link: '/clusters/verborgen-gebreken-bedrijfspand' },
  { term: 'Bankgarantie', def: 'Verklaring van een bank dat zij op eerste verzoek of onder voorwaarden een bedrag uitkeert aan de begunstigde. In de procespraktijk het gangbare middel om beslag opgeheven te krijgen of zekerheid te stellen zonder geld vast te zetten.', link: '/clusters/beslag-opheffen' },
  { term: 'Betekening', def: 'De officiële uitreiking van een exploot (zoals een dagvaarding of vonnis) door de gerechtsdeurwaarder. Betekening markeert het moment waarop termijnen gaan lopen en is vereist voordat een vonnis kan worden geëxecuteerd.', link: '/proceskosten-berekenen' },
  { term: 'BHAC', def: 'Bedrijfshuuradviescommissie: commissie van deskundigen die bij een huurprijsherziening van 290-bedrijfsruimte adviseert over de huurprijs op basis van vergelijkbare bedrijfsruimte ter plaatse.', link: '/clusters/huurprijswijziging-7-303-roz' },
  { term: 'Billijke vergoeding', def: 'Vergoeding die de rechter aan een werknemer of statutair bestuurder kan toekennen naast de transitievergoeding, wanneer het ontslag het gevolg is van ernstig verwijtbaar handelen van de werkgever of een redelijke grond ontbreekt.', link: '/clusters/ontslag-statutair-bestuurder' },
  { term: 'Bodemprocedure', def: 'De gewone, volledige gerechtelijke procedure waarin een geschil definitief wordt beslist — in tegenstelling tot het kort geding, dat slechts een voorlopige voorziening geeft.', link: '/praktijkgebieden/burgerlijk-procesrecht' },
  { term: 'Boedelschuld', def: 'Schuld die tijdens het faillissement ontstaat of door de wet als boedelschuld wordt aangemerkt (zoals huur vanaf de faillissementsdatum). Boedelschulden worden vóór alle geverifieerde vorderingen uit de boedel voldaan.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Buitengerechtelijke incassokosten', def: 'De wettelijk genormeerde vergoeding voor incassokosten: 15% over de eerste € 2.500 van de hoofdsom, aflopend tot 0,5%, met een minimum van € 40 en een maximum van € 6.775. Bij consumenten dwingend en pas verschuldigd na een correcte veertiendagenbrief.', link: '/clusters/factuur-niet-betaald' },
  { term: 'CAR-verzekering', def: 'Construction All Risks-verzekering: dekt materiële schade aan het werk tijdens de bouw. Relevant bij bouwschade en bij een faillissement van de aannemer, omdat de dekking aan het project of aan partijen gekoppeld kan zijn.', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: 'Concurrente vordering', def: 'Gewone, niet-bevoorrechte vordering in een faillissement. Concurrente schuldeisers komen na de boedelschulden en preferente schuldeisers en ontvangen in de meeste faillissementen geen of een beperkte uitkering.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Conformiteit', def: 'De eis dat een geleverde zaak de eigenschappen bezit die de koper op grond van de overeenkomst mocht verwachten (artikel 7:17 BW), waaronder geschiktheid voor normaal gebruik. Het juridische anker bij verborgen gebreken.', link: '/clusters/verborgen-gebreken-bedrijfspand' },
  { term: 'Conservatoir beslag', def: 'Bewarend beslag dat een schuldeiser vóór of tijdens een procedure legt om verhaal veilig te stellen, met verlof van de voorzieningenrechter. Wordt executoriaal zodra een toewijzend vonnis is verkregen.', link: '/clusters/conservatoir-beslag' },
  { term: 'Curator', def: 'De door de rechtbank benoemde advocaat die in een faillissement het vermogen van de schuldenaar beheert en vereffent ten behoeve van de gezamenlijke schuldeisers, onder toezicht van de rechter-commissaris.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Dagvaarding', def: 'Het exploot waarmee een civiele procedure wordt ingeleid: de gedaagde wordt opgeroepen voor de rechter te verschijnen en de eis wordt uiteengezet. Wordt door de deurwaarder betekend.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Derdenbeslag', def: 'Beslag onder een derde die iets aan de schuldenaar verschuldigd is — meestal de bank (bankbeslag) of een debiteur van de schuldenaar. De derde moet verklaren wat hij onder zich heeft.', link: '/clusters/beslag-op-bankrekening' },
  { term: 'Due diligence', def: 'Boekenonderzoek voorafgaand aan een overname of vastgoedtransactie: juridisch, financieel, fiscaal en technisch. De bevindingen vertalen zich in de prijs, garanties en vrijwaringen in het contract.', link: '/clusters/verkoop-bedrijfspand-mna' },
  { term: 'Dwaling', def: 'Vernietigingsgrond voor een overeenkomst die is gesloten onder een onjuiste voorstelling van zaken (artikel 6:228 BW), bijvoorbeeld door een ondeugdelijke omzetprognose of een verzwegen gebrek.', link: '/clusters/franchise-geschillen' },
  { term: 'Dwangsom', def: 'Door de rechter opgelegde prikkel tot nakoming: een geldbedrag dat verbeurt voor iedere dag of overtreding waarmee een veroordeling niet wordt nageleefd.', link: '/specialisme/kort-geding' },
  { term: 'Eigendomsvoorbehoud', def: 'Beding waarmee een leverancier eigenaar blijft van geleverde zaken totdat zij zijn betaald (artikel 3:92 BW). In faillissement kan de leverancier onbetaalde zaken dan terugvorderen, mits ze identificeerbaar en onverwerkt zijn.', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: 'Executoriaal beslag', def: 'Beslag op basis van een executoriale titel (meestal een vonnis) waarmee daadwerkelijk verhaal wordt genomen: het beslagene wordt uitgewonnen om de vordering te voldoen.', link: '/specialisme/incasso-en-executie' },
  { term: 'Exoneratiebeding', def: 'Contractsbeding dat aansprakelijkheid uitsluit of beperkt. Tussen professionele partijen in beginsel geldig, maar de redelijkheid en billijkheid en de aard van de schuld (opzet, bewuste roekeloosheid) begrenzen de werking.', link: '/clusters/exoneratiebeding-zakelijke-contracten' },
  { term: 'Exploot', def: 'Officieel deurwaardersstuk, zoals een dagvaarding, betekening of beslaglegging. De schuldenaarstarieven per ambtshandeling zijn wettelijk vastgelegd in het Btag.', link: '/proceskosten-berekenen' },
  { term: 'Fatale termijn', def: 'Een voor de nakoming overeengekomen termijn waarvan het verstrijken de schuldenaar direct in verzuim brengt, zonder dat een ingebrekestelling nodig is (artikel 6:83 sub a BW). Betaaltermijnen van facturen gelden doorgaans als fataal.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Gestanddoening', def: 'De verklaring van een curator dat hij een lopende wederkerige overeenkomst van de gefailleerde nakomt (artikel 37 Fw). De wederpartij kan de curator daarvoor een redelijke termijn stellen; blijft gestanddoening uit, dan kan zij ontbinden.', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: 'Goodwill', def: 'De meerwaarde van een onderneming boven de waarde van de afzonderlijke activa, zoals klantenbestand en naamsbekendheid. De Wet franchise verplicht een contractuele regeling over goodwillvergoeding bij het einde van de franchise.', link: '/clusters/franchise-geschillen' },
  { term: 'Griffierecht', def: 'De bijdrage die de rechtspraak per zaak in rekening brengt. De hoogte hangt af van de instantie, de omvang van de vordering en de hoedanigheid van de partij, en wordt jaarlijks geïndexeerd.', link: '/proceskosten-berekenen' },
  { term: 'Handelsrente', def: 'De wettelijke rente voor handelstransacties tussen ondernemingen (artikel 6:119a BW), aanzienlijk hoger dan de gewone wettelijke rente. Loopt vanaf het verstrijken van de betaaltermijn automatisch en wordt jaarlijks samengesteld.', link: '/proceskosten-berekenen' },
  { term: 'Homologatie', def: 'De rechterlijke goedkeuring van een akkoord, zoals een WHOA-akkoord. Door homologatie wordt het akkoord verbindend, ook voor schuldeisers die tegenstemden.', link: '/clusters/whoa-traject-ondernemer-kosten-kansen' },
  { term: 'Ingebrekestelling', def: 'Schriftelijke aanmaning waarin de schuldenaar een redelijke termijn krijgt om alsnog na te komen, op straffe van verzuim. Het scharnier van vrijwel elk incasso- en wanprestatietraject.', link: '/modelbrieven' },
  { term: 'Instemmingsrecht (franchise)', def: 'Het recht van franchisenemers om vooraf in te stemmen met formulewijzigingen die investeringen vergen of boven een contractuele drempel tot omzetderving of kostenstijging leiden (artikel 7:921 BW).', link: '/clusters/franchise-geschillen' },
  { term: 'Klachtplicht', def: 'De plicht van een koper of opdrachtgever om binnen bekwame tijd na ontdekking van een gebrek te klagen (artikel 7:23 en 6:89 BW), op straffe van verval van alle rechten. Na de klacht loopt een verjaringstermijn van twee jaar.', link: '/clusters/verborgen-gebreken-bedrijfspand' },
  { term: 'Kort geding', def: 'Spoedprocedure bij de voorzieningenrechter voor een voorlopige voorziening, zoals een verbod, ontruiming of opheffing van beslag. Geen definitief oordeel: dat blijft aan de bodemrechter.', link: '/specialisme/kort-geding' },
  { term: 'Liquidatietarief', def: 'Het forfaitaire puntensysteem waarmee rechters het salaris van de advocaat begroten in de proceskostenveroordeling. Dekt de werkelijke advocaatkosten doorgaans slechts gedeeltelijk.', link: '/proceskosten-berekenen' },
  { term: 'Managementovereenkomst', def: 'Overeenkomst van opdracht tussen een vennootschap en een management-BV waarlangs een bestuurder zijn diensten verleent. Het arbeidsrecht geldt dan in beginsel niet, al kijkt de rechter door de constructie heen bij een feitelijke gezagsverhouding.', link: '/clusters/ontslag-statutair-bestuurder' },
  { term: 'Natrekking', def: 'Eigendomsverkrijging doordat een zaak bestanddeel wordt van een andere zaak: wat duurzaam met de grond of het gebouw wordt verenigd, wordt eigendom van de eigenaar daarvan — ook als de leverancier nog niet is betaald.', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: 'Ontruimingsbescherming', def: 'De bescherming van huurders van 230a-bedrijfsruimte na het einde van de huur: de ontruiming wordt op verzoek geschorst, telkens met maximaal een jaar, tot ten hoogste drie jaar.', link: '/clusters/bedrijfsruimte-290-of-230a-bw' },
  { term: 'Opschorting', def: 'Het recht om de eigen prestatie uit te stellen zolang de wederpartij haar opeisbare verplichting niet nakomt (artikel 6:52 en 6:262 BW). Veelgebruikt drukmiddel bij betalings- en bouwgeschillen.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Ouderdomsclausule', def: 'Beding in een koopovereenkomst van ouder vastgoed dat de verwachtingen van de koper verlaagt tot wat bij de leeftijd van het pand past. Wordt restrictief uitgelegd: leeftijdsgebonden gebreken wel, gebreken uit recente verbouwingen niet zonder meer.', link: '/clusters/verborgen-gebreken-bedrijfspand' },
  { term: 'Pluraliteit', def: 'Het vereiste voor een faillietverklaring dat de schuldenaar meerdere schuldeisers heeft. De aanvrager moet daarom naast zijn eigen vordering een steunvordering van een andere schuldeiser aannemelijk maken.', link: '/clusters/faillissement-aanvragen-schuldeiser' },
  { term: 'Preferente vordering', def: 'Vordering met wettelijke voorrang in faillissement, zoals die van de fiscus en het UWV. Preferente schuldeisers ontvangen vóór de concurrente schuldeisers een uitkering uit de boedel.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Proceskostenveroordeling', def: 'De veroordeling van de verliezende partij in de proceskosten van de winnaar: griffierecht, explootkosten en een forfaitair advocaatsalaris volgens het liquidatietarief.', link: '/proceskosten-berekenen' },
  { term: 'Raadgevende stem', def: 'Het recht van een bestuurder om in de algemene vergadering zijn visie te geven voordat wordt besloten (artikel 2:227 lid 7 BW). Schending maakt het besluit — zoals een ontslagbesluit — vernietigbaar.', link: '/clusters/ontslag-statutair-bestuurder' },
  { term: 'Rechter-commissaris', def: 'De rechter die toezicht houdt op de curator in een faillissement. Voor belangrijke beheershandelingen heeft de curator diens machtiging nodig; schuldeisers kunnen bij de rechter-commissaris opkomen tegen handelingen van de curator.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Retentierecht', def: 'De bevoegdheid van een schuldeiser om een zaak die hij onder zich heeft — zoals een bouwwerk — niet af te geven totdat zijn opeisbare vordering is betaald, met voorrang bij verhaal op de zaak (artikel 3:290 BW).', link: '/clusters/retentierecht-bouw' },
  { term: 'Standstill-periode', def: 'De wettelijke bedenktermijn van vier weken tussen het verstrekken van de precontractuele franchise-informatie en het sluiten van de franchiseovereenkomst, waarin de aspirant niet tot tekenen of investeren mag worden bewogen.', link: '/clusters/franchise-geschillen' },
  { term: 'Statutair bestuurder', def: 'Bestuurder die door het bevoegde orgaan (meestal de AVA) is benoemd en als zodanig is ingeschreven. Kan te allen tijde vennootschapsrechtelijk worden ontslagen; herstel van de arbeidsovereenkomst is uitgesloten.', link: '/clusters/ontslag-statutair-bestuurder' },
  { term: 'Steunvordering', def: 'De vordering van een tweede schuldeiser die bij een faillissementsaanvraag nodig is om aan het pluraliteitsvereiste te voldoen. Hoeft niet opeisbaar te zijn, wel aannemelijk.', link: '/clusters/faillissement-aanvragen-schuldeiser' },
  { term: 'Stuiting', def: 'Handeling die een lopende verjaring afbreekt en een nieuwe termijn laat beginnen, bijvoorbeeld door een schriftelijke aanmaning waarin het recht op nakoming ondubbelzinnig wordt voorbehouden (artikel 3:317 BW).', link: '/clusters/factuur-niet-betaald' },
  { term: 'Surseance van betaling', def: 'Gerechtelijk uitstel van betaling voor ondernemingen in tijdelijke betalingsproblemen. In de praktijk vaak een voorportaal van faillissement; de WHOA biedt tegenwoordig meestal een effectiever alternatief.', link: '/praktijkgebieden/insolventie-en-herstructurering' },
  { term: 'Terme de grâce', def: 'De laatste betaaltermijn van maximaal één maand die de rechter een huurder kan gunnen om een huurachterstand alsnog te voldoen en zo ontbinding en ontruiming af te wenden (artikel 7:280 BW).', link: '/clusters/huurachterstand-bedrijfsruimte-ontbinding' },
  { term: 'Transitievergoeding', def: 'De wettelijke vergoeding waarop een werknemer — ook een statutair bestuurder — in beginsel recht heeft bij beëindiging van de arbeidsovereenkomst op initiatief van de werkgever, berekend naar dienstjaren en salaris.', link: '/clusters/ontslag-statutair-bestuurder' },
  { term: 'Uitvoerbaar bij voorraad', def: 'Verklaring van de rechter dat een vonnis direct mag worden geëxecuteerd, ook als hoger beroep wordt ingesteld. Standaard bij incasso- en ontruimingsvonnissen.', link: '/clusters/ontruiming-bedrijfsruimte' },
  { term: 'Vaststellingsovereenkomst', def: 'Overeenkomst waarmee partijen een geschil of onzekerheid definitief regelen, ook als de afspraken afwijken van wat rechtens zou gelden. De gebruikelijke afronding van geschillen en beëindigingstrajecten.', link: '/specialisme/contractgeschillen' },
  { term: 'Veertiendagenbrief', def: 'De wettelijk verplichte kosteloze laatste aanmaning aan een consument-schuldenaar, met een betaaltermijn van veertien dagen vanaf de dag na bezorging en vermelding van het exacte incassokostenbedrag. Bij een verkeerde formulering zijn geen incassokosten verschuldigd.', link: '/modelbrieven' },
  { term: 'Verborgen gebrek', def: 'Gebrek aan een gekochte zaak dat bij de koop niet kenbaar was en dat het normale gebruik belemmert, zoals funderingsproblemen of bodemverontreiniging. De koper moet tijdig klagen en de contractuele risicoverdeling beslist vaak het geschil.', link: '/clusters/verborgen-gebreken-bedrijfspand' },
  { term: 'Verificatie', def: 'De vaststelling van vorderingen in een faillissement: schuldeisers dienen hun vordering met bewijsstukken in bij de curator, die haar op de lijst van erkende of betwiste vorderingen plaatst.', link: '/clusters/vordering-indienen-curator' },
  { term: 'Verjaring', def: 'Het vervallen van de afdwingbaarheid van een vordering door tijdsverloop: factuurvorderingen verjaren in beginsel na vijf jaar, bij consumentenkoop al na twee jaar. Tijdig stuiten houdt de vordering in stand.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Verrekening', def: 'Het tegen elkaar wegstrepen van vorderingen die partijen over en weer hebben. In faillissement toegestaan als beide vorderingen vóór het faillissement zijn ontstaan of uit dezelfde eerdere rechtsverhouding voortvloeien (artikel 53 Fw).', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: 'Verstekvonnis', def: 'Vonnis dat wordt gewezen wanneer de gedaagde niet in de procedure verschijnt: de vordering wordt toegewezen tenzij zij de rechter ongegrond of onrechtmatig voorkomt. Sneller en goedkoper dan veel schuldeisers denken.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Verzuim', def: 'De toestand waarin een schuldenaar verkeert die opeisbaar moet presteren maar dat niet doet, na ingebrekestelling of direct bij een fatale termijn. Startpunt voor rente, incassokosten en ontbinding.', link: '/clusters/factuur-niet-betaald' },
  { term: 'Voorzieningenrechter', def: 'De rechter die in kort geding voorlopige voorzieningen treft en die verlof verleent voor conservatoir beslag. Onderdeel van de rechtbank.', link: '/specialisme/kort-geding' },
  { term: 'Vrijwaring', def: 'Contractuele toezegging dat de ene partij de schade draagt als een specifiek benoemd risico zich verwezenlijkt, bijvoorbeeld een fiscale claim uit het verleden bij een overname. Sterker dan een garantie: aansprakelijkheid staat vast zodra het risico intreedt.', link: '/clusters/verkoop-bedrijfspand-mna' },
  { term: 'Wet franchise', def: 'Titel 7.16 BW (sinds 2021, volledig sinds 2023 ook voor oudere contracten): dwingend kader voor franchiseovereenkomsten met een precontractuele informatieplicht, standstill-periode, goodwillregeling, begrensd non-concurrentiebeding en instemmingsrecht.', link: '/clusters/franchise-geschillen' },
  { term: 'Wettelijke rente', def: 'De rente die de wet verbindt aan te late betaling: de gewone wettelijke rente (artikel 6:119 BW) voor niet-handelstransacties en de hogere handelsrente voor transacties tussen ondernemingen, telkens samengesteld per jaar.', link: '/proceskosten-berekenen' },
  { term: 'Vijfprocentsregeling', def: 'Het recht van een consument-opdrachtgever bij nieuwbouw om 5% van de aanneemsom in depot bij de notaris te storten als zekerheid voor herstel van opleveringsgebreken (artikel 7:768 BW).', link: '/clusters/aannemer-failliet-tijdens-bouw' },
  { term: '7:230a BW', def: 'Huurregime voor niet-publieksgerichte bedrijfsruimte (kantoren, magazijnen, bedrijfshallen). Geen huurprijsbescherming, beperkte ontruimingsbescherming.', link: '/clusters/bedrijfsruimte-290-of-230a-bw' },
  { term: '7:290 BW', def: 'Huurregime voor publieksgerichte bedrijfsruimte (winkels, horeca, ambacht). Streng wettelijk beschermingsregime voor de huurder qua contractduur en huurprijs.', link: '/clusters/bedrijfsruimte-290-of-230a-bw' },
];

// Sort by term, group by first letter
terms.sort((a, b) => a.term.localeCompare(b.term, 'nl'));

function termSlug(term: string): string {
  return term
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
const grouped: Record<string, Term[]> = {};
for (const t of terms) {
  const letter = t.term[0].toUpperCase().match(/[A-Z]/) ? t.term[0].toUpperCase() : '#';
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(t);
}
const letters = Object.keys(grouped).sort();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Woordenlijst', url: '/woordenlijst' },
];

const glossarySchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: pageTitle,
  description: pageDescription,
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.def,
    inDefinedTermSet: 'https://clavix.nl/woordenlijst',
    ...(t.link ? { url: `https://clavix.nl${t.link}` } : {}),
  })),
};

const schemas = [organizationSchema, breadcrumbSchema(breadcrumbs), glossarySchema];
---

<BaseLayout title={pageTitle} description={pageDescription} schemaJsonLd={schemas}>
  <article>
    {/* === HERO === */}
    <section class="bg-bg-tinted">
      <div class="max-w-content mx-auto px-4 md:px-8 py-12 md:py-16">
        <p class="text-tiny font-semibold uppercase tracking-wider text-text-secondary mb-3">
          <a href="/" class="hover:text-text-accent">Home</a> ›{' '}
          <span class="text-text">Woordenlijst</span>
        </p>
        <h1 class="text-display font-extrabold text-text mb-4 tracking-tight">{pageTitle}</h1>
        <p class="text-lead text-text-secondary max-w-prose">
          Begrippenlijst met de juridische termen die u in onze artikelen tegenkomt — kort en helder uitgelegd voor ondernemers. {terms.length} termen uit ondernemingsrecht, vastgoedrecht en insolventierecht.
        </p>
      </div>
    </section>

    {/* === ALPHABET NAV === */}
    <nav class="sticky top-0 bg-bg z-10 border-b border-border shadow-sm" aria-label="Alfabet-navigatie">
      <div class="max-w-content mx-auto px-4 md:px-8 py-3 flex flex-wrap gap-x-4 gap-y-2">
        {letters.map((letter) => (
          <a
            href={`#${letter.toLowerCase()}`}
            class="text-h3 font-bold text-text-accent hover:underline"
            aria-label={`Spring naar letter ${letter}`}
          >
            {letter}
          </a>
        ))}
      </div>
    </nav>

    {/* === TERMS === */}
    <section>
      <div class="max-w-content mx-auto px-4 md:px-8 py-12">
        {letters.map((letter) => (
          <div class="mb-12">
            <h2
              id={letter.toLowerCase()}
              class="text-display font-bold text-text-accent mb-6 pb-2 border-b-2 border-border scroll-mt-20"
            >
              {letter}
            </h2>
            <dl class="space-y-6">
              {grouped[letter].map((t) => (
                <div id={termSlug(t.term)} class="scroll-mt-24">
                  <dt class="text-h3 font-bold text-text mb-2">
                    {t.link ? (
                      <a href={t.link} class="hover:text-text-accent">{t.term}</a>
                    ) : (
                      t.term
                    )}
                  </dt>
                  <dd class="text-body text-text-secondary max-w-prose">{t.def}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <CTABand />
  </article>
</BaseLayout>
